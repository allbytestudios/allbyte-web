# Copy this file to .env in the same directory before the first
# `docker compose up`. The actual .env file is gitignored.
#
# Generate JWT_SECRET via: openssl rand -hex 32
# (or any 32+ char random string — used to sign Postiz session tokens)

JWT_SECRET=replace-me-with-openssl-rand-hex-32

# Defaults are fine for purely local testing — Postiz UI at
# http://localhost:5000. Override only when exposing to public URLs
# for real OAuth flows.
#
# MAIN_URL=http://localhost:5000
# FRONTEND_URL=http://localhost:5000
# NEXT_PUBLIC_BACKEND_URL=http://localhost:3000

# Port overrides if 5000 / 3000 conflict with something else on your host.
#
# POSTIZ_FRONTEND_PORT=5000
# POSTIZ_BACKEND_PORT=3000

# Per-platform OAuth credentials (Discord/Bluesky/etc.) belong in a
# gitignored compose override file, not here. See
# `docker-compose.override.yml` (gitignored) in this directory.
