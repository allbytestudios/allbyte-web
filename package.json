{
  "name": "allbyte-web",
  "version": "1.0.0",
  "description": "AllByte Studios web portal",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-assets.js",
    "push-assets": "node scripts/push-assets.js",
    "sync:watch": "node scripts/sync-test-data-watcher.js",
    "sync:once": "node scripts/sync-test-data-watcher.js --once",
    "sync:dry": "node scripts/sync-test-data-watcher.js --once --dry-run",
    "sync:test": "node scripts/sync-test-data-watcher.js --self-test",
    "sync:marketing": "node scripts/sync-marketing-posts.mjs",
    "sync:scenarios": "node scripts/sync-scenario-fixtures.js",
    "sync:tree": "node scripts/sync-save-tree.js",
    "sync:dialogue": "node scripts/sync-dialogue.js",
    "deploy:tree": "node scripts/deploy-tree.js",
    "changelog": "node scripts/deploy-history.js",
    "promote": "node scripts/promote.js",
    "finalize": "node scripts/finalize-web-deploy.js",
    "finalize:channel": "node scripts/finalize-channel.js",
    "usage": "node scripts/claude-usage.js",
    "push-packs": "node scripts/push-packs.js",
    "obfuscate-godot": "node scripts/obfuscate-godot-export.js",
    "deploy-watcher": "node scripts/deploy-watcher.js",
    "deploy-watcher:once": "node scripts/deploy-watcher.js --once",
    "dev": "astro dev --host 0.0.0.0",
    "build": "node scripts/sync-assets.js && astro build && node scripts/inject-sw-version.js",
    "preview": "astro preview",
    "astro": "astro",
    "test:a11y": "pytest tests/e2e/test_accessibility.py -v",
    "test:e2e": "pytest tests/e2e/ -v",
    "smoke:prod": "python scripts/smoke_prod.py",
    "qa:controllers": "python tests/controller-qa/run_qa.py",
    "qa:browsers": "python tests/cross-browser-qa/run.py",
    "push-marketing-strategy": "node scripts/push-marketing-strategy.js",
    "sync:walkthrough": "node scripts/sync-walkthrough.js",
    "sync:walkthrough:dry": "node scripts/sync-walkthrough.js --dry-run",
    "sync:walkthrough-edits": "node scripts/sync-walkthrough-edits.js",
    "check:manual": "node scripts/check-manual-drift.js",
    "sync:manual": "node scripts/sync-manual.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allbytestudios/allbyte-web.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/allbytestudios/allbyte-web/issues"
  },
  "homepage": "https://github.com/allbytestudios/allbyte-web#readme",
  "dependencies": {
    "@astrojs/svelte": "^8.0.4",
    "@tailwindcss/vite": "^4.2.2",
    "@zumer/snapdom": "^2.23.2",
    "astro": "^6.1.4",
    "remark-directive": "^4.0.0",
    "svelte": "^5.55.1",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "js-yaml": "^5.2.1"
  }
}
