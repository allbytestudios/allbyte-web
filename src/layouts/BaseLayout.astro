---
import { ClientRouter } from "astro:transitions";
import MusicPlayer from "../components/MusicPlayer.svelte";
import AuthInit from "../components/AuthInit.svelte";
import DevAuthSwitcher from "../components/DevAuthSwitcher.svelte";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "AllByte Studios",
  description = "Indie game studio - Play Chronicles of Nesis, Read the Devlog, Browse the Asset Archive",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/icon.png" />

    <!-- PWA: manifest + theme color drive Android install eligibility and
         the address-bar tint on mobile. -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0a0e17" />

    <!-- iOS PWA forward-compat (not optimized for iOS yet, but adding the
         meta tags now means the install flow already works when we turn
         to it — no architectural rework needed). screen.orientation.lock
         doesn't exist on iOS in a browser tab, but the manifest's
         "orientation": "landscape" is honored once installed via
         Share → Add to Home Screen. -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Chronicles" />
    <link rel="apple-touch-icon" href="/godot/index.apple-touch-icon.png" />

    <title>{title}</title>

    <!-- Installed-PWA hard redirect: if the user launched the installed
         standalone app and landed anywhere outside /play/ (typically
         because their browser cached an earlier manifest with start_url:
         "/" before we fixed it), bounce straight to the game. Runs
         synchronously in head so there's no homepage flash. Only fires
         once per session (sessionStorage flag) so the user can still
         navigate to other pages from inside the PWA after the first
         landing — but the first launch always goes to the game. -->
    <script is:inline>
      try {
        var inStandalone =
          window.matchMedia &&
          window.matchMedia("(display-mode: standalone)").matches;
        if (
          inStandalone &&
          window.location.pathname === "/" &&
          !sessionStorage.getItem("__pwa_launched")
        ) {
          sessionStorage.setItem("__pwa_launched", "1");
          window.location.replace("/play/");
        }
      } catch (e) {}
    </script>
    <ClientRouter />
  </head>
  <body>
    <AuthInit client:load />
    <DevAuthSwitcher client:load />
    <slot />
    <div transition:persist="music-player">
      <MusicPlayer client:load />
    </div>
    <script>
      // Set body.is-hero-plus / body.is-admin once auth resolves, so CSS
      // rules gated on those classes (draft devlog previews, deep test
      // inspection, etc.) can reveal tier-gated content without a server
      // round-trip per element. Re-runs on every client-side navigation.
      function syncTierClasses() {
        document.body.classList.remove("is-admin", "is-hero-plus");

        // Localhost dev: match the auto-login in auth.svelte.ts. Gives the
        // admin/legend preview without needing a real JWT.
        const isLocalDev =
          typeof window !== "undefined" &&
          (window.location.hostname === "localhost" ||
            window.location.hostname === "127.0.0.1");
        if (isLocalDev) {
          document.body.classList.add("is-hero-plus", "is-admin");
          return;
        }

        const token = localStorage.getItem("allbyte_token");
        if (!token) return;
        fetch("https://api.allbyte.studio/auth/me", {
          headers: { Authorization: `Bearer ${token}` },
        })
          .then((r) => (r.ok ? r.json() : null))
          .then((d) => {
            const tier = d?.user?.tier;
            if (tier === "hero" || tier === "legend" || tier === "admin") {
              document.body.classList.add("is-hero-plus");
            }
            if (tier === "admin") {
              document.body.classList.add("is-admin");
            }
          })
          .catch(() => {});
      }
      syncTierClasses();
      document.addEventListener("astro:page-load", syncTierClasses);

      // Service worker: caches /godot/* so repeat visits to /play/ skip the
      // ~60MB download and WASM compile. Registered globally so it's live
      // before the user first navigates to /play/.
      if ("serviceWorker" in navigator && location.protocol === "https:") {
        // localhost falls through with protocol "http:" — don't register
        // there because the SW would intercept dev-server requests and
        // mask Vite HMR / live-reload behavior.
        navigator.serviceWorker
          .register("/sw.js")
          .catch((err) =>
            console.warn("[sw] registration failed:", err)
          );
      }
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
