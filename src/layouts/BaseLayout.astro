---
import { ClientRouter } from "astro:transitions";
import MusicPlayer from "../components/MusicPlayer.svelte";
import AuthInit from "../components/AuthInit.svelte";
import DevAuthSwitcher from "../components/DevAuthSwitcher.svelte";
import UpdateOverlay from "../components/UpdateOverlay.svelte";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
}

const {
  title = "AllByte Studios",
  description = "A handcrafted tactical RPG in the spirit of 90s JRPGs from AllByte Studios — play free in your browser.",
  image = "/og-image.jpg",
  type = "website",
} = Astro.props;

// Absolute URLs for link-preview cards (OG/Twitter require absolute, https).
const SITE = "https://allbyte.studio";
const canonical = new URL(Astro.url.pathname, SITE).href;
const imageAbs = new URL(image, SITE).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph + Twitter link-preview cards. Platforms (Bluesky, Threads,
         X, Discord, etc.) render a thumbnail card from these when a link is
         shared. Per-page overridable via the title/description/image props. -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="AllByte Studios" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageAbs} />

    <!-- PWA: manifest + theme color drive Android install eligibility and
         the address-bar tint on mobile. -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0a0e17" />

    <!-- iOS PWA forward-compat (not optimized for iOS yet, but adding the
         meta tags now means the install flow already works when we turn
         to it — no architectural rework needed). screen.orientation.lock
         doesn't exist on iOS in a browser tab, but the manifest's
         "orientation": "landscape" is honored once installed via
         Share → Add to Home Screen. -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Chronicles of Nesis" />
    <meta name="application-name" content="Chronicles of Nesis" />
    <link rel="apple-touch-icon" href="/icon-512.png" />

    <title>{title}</title>

    <!-- Installed-PWA hard redirect: the installed app is the game. If
         the user ever lands on "/" while running in standalone mode —
         on cold launch, on accidental in-app nav, on a cached old
         manifest, doesn't matter — bounce to /play/. Owner spec: "I
         want to click the PWA and go straight to the game. The user
         will go to the webpage if they want to see our home screen."
         Runs synchronously in head so there's no homepage flash, and
         on every astro:page-load so SPA nav inside the PWA also gets
         caught (not just the cold launch). -->
    <script is:inline>
      function __redirectIfPwaHome() {
        try {
          var inStandalone =
            window.matchMedia &&
            window.matchMedia("(display-mode: standalone)").matches;
          // OAuth callback guard: the login token comes back in the hash
          // (".../#token=..."). If the installed PWA captures that redirect,
          // we must NOT bounce to /play/ — that drops the token (hashes aren't
          // carried on a location.replace) and dumps the user into the game
          // unauthenticated. Let AuthInit process the token on "/" first. A
          // session marker persists the skip across the hash-clear so the
          // post-login pass doesn't bounce either; a fresh launch resets it.
          if (/(?:^|[#&])token=/.test(window.location.hash || "")) {
            try { sessionStorage.setItem("ab_oauth_landing", "1"); } catch (e) {}
          }
          var justAuthed = false;
          try { justAuthed = sessionStorage.getItem("ab_oauth_landing") === "1"; } catch (e) {}
          if (inStandalone && window.location.pathname === "/" && !justAuthed) {
            window.location.replace("/play/");
          }
        } catch (e) {}
      }
      __redirectIfPwaHome();
      document.addEventListener("astro:page-load", __redirectIfPwaHome);
    </script>
    <ClientRouter />
  </head>
  <body>
    <AuthInit client:load />
    <DevAuthSwitcher client:load />
    <UpdateOverlay client:load />
    <slot />
    <div transition:persist="music-player">
      <MusicPlayer client:load />
    </div>
    <script>
      // Set body.is-hero-plus / body.is-admin once auth resolves, so CSS
      // rules gated on those classes (draft devlog previews, deep test
      // inspection, etc.) can reveal tier-gated content without a server
      // round-trip per element. Re-runs on every client-side navigation.
      function syncTierClasses() {
        document.body.classList.remove("is-admin", "is-hero-plus");

        // Localhost dev: match the auto-login in auth.svelte.ts. Gives the
        // admin/legend preview without needing a real JWT.
        const isLocalDev =
          typeof window !== "undefined" &&
          (window.location.hostname === "localhost" ||
            window.location.hostname === "127.0.0.1");
        if (isLocalDev) {
          document.body.classList.add("is-hero-plus", "is-admin");
          return;
        }

        const token = localStorage.getItem("allbyte_token");
        if (!token) return;
        fetch("https://api.allbyte.studio/auth/me", {
          headers: { Authorization: `Bearer ${token}` },
        })
          .then((r) => (r.ok ? r.json() : null))
          .then((d) => {
            const tier = d?.user?.tier;
            if (tier === "hero" || tier === "legend" || tier === "admin") {
              document.body.classList.add("is-hero-plus");
            }
            if (tier === "admin") {
              document.body.classList.add("is-admin");
            }
          })
          .catch(() => {});
      }
      syncTierClasses();
      document.addEventListener("astro:page-load", syncTierClasses);

      // Service worker: caches /godot/* so repeat visits to /play/ skip the
      // ~60MB download and WASM compile. Registered globally so it's live
      // before the user first navigates to /play/.
      if ("serviceWorker" in navigator && location.protocol === "https:") {
        // localhost falls through with protocol "http:" — don't register
        // there because the SW would intercept dev-server requests and
        // mask Vite HMR / live-reload behavior.
        navigator.serviceWorker
          .register("/sw.js")
          .then((reg) => {
            // Force an update check on THIS load, not just on visibilitychange.
            // A fresh page load / PWA relaunch calls register(), but that check
            // is throttled and unreliable (proven by the SW recovery test:
            // navigation alone didn't pick up a bumped SW). An explicit
            // update() reliably detects a new worker, so a returning or
            // relaunching user recovers from a stale build on the next open.
            reg.update().catch(() => {});
            // Also re-poll when the tab becomes visible, for a PWA left open
            // across a deploy (no real navigation; ClientRouter doesn't count).
            document.addEventListener("visibilitychange", () => {
              if (document.visibilityState === "visible") {
                reg.update().catch(() => {});
              }
            });
          })
          .catch((err) =>
            console.warn("[sw] registration failed:", err)
          );
      }
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
