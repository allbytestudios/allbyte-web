---
import ManualLayout from "../layouts/ManualLayout.astro";
import changelog from "../data/changelog.json";

// Player-facing group labels + display order. feat/fix lead; the engineering
// types follow (kept visible on purpose — the "Engine" side is transparent
// about how the game is built).
const TYPE_META: Record<string, { label: string; order: number }> = {
  feat:     { label: "New",         order: 1 },
  fix:      { label: "Fixed",       order: 2 },
  refactor: { label: "Improved",    order: 3 },
  test:     { label: "Tested",      order: 4 },
  tools:    { label: "Tooling",     order: 5 },
  release:  { label: "Release",     order: 6 },
  docs:     { label: "Docs",        order: 7 },
  chore:    { label: "Maintenance", order: 8 },
};

function grouped(changes: { type: string; scope?: string; subject: string; sha: string }[]) {
  const by: Record<string, typeof changes> = {};
  for (const c of changes) (by[c.type] ??= []).push(c);
  return Object.entries(by)
    .map(([type, items]) => ({ type, label: TYPE_META[type]?.label ?? type, order: TYPE_META[type]?.order ?? 99, items }))
    .sort((a, b) => a.order - b.order);
}

const releases = changelog.releases ?? [];
const fmtDate = (d: string) =>
  new Date(d + "T00:00:00Z").toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });
---

<ManualLayout
  title="What's New — The Chronicles of Nesis"
  description="Release notes for The Chronicles of Nesis — what shipped in each public build, engineered with AI."
  active="/changelog/"
>
  <main class="changelog">
    <header class="page-head">
      <p class="eyebrow">Release Notes</p>
      <h1>What's New</h1>
      <hr class="rule" />
      <p class="intro">
        Every public build of <strong>The Chronicles of Nesis</strong>, newest first.
      </p>
    </header>

    {releases.length === 0 && <p class="muted">No releases recorded yet.</p>}

    {releases.map((rel: any) => (
      <section class="release">
        <header class="release-head">
          <h2 class="release-version">{rel.version}</h2>
          <time class="release-date" datetime={rel.date}>{fmtDate(rel.date)}</time>
          <span class="release-count">{rel.changes.length} change{rel.changes.length === 1 ? "" : "s"}</span>
        </header>
        {grouped(rel.changes).map((g) => (
          <div class="group">
            <h3 class={`group-label group-${g.type}`}>{g.label}</h3>
            <ul class="changes">
              {g.items.map((c: any) => (
                <li class="change">
                  {c.scope && <span class="scope">{c.scope}</span>}
                  <span class="subject">{c.subject}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    ))}
  </main>
</ManualLayout>

<style>
  .changelog {
    width: 100%;
    max-width: 820px;
    margin: 0 auto;
    padding: clamp(1.6rem, 4vw, 2.6rem) clamp(1.1rem, 4vw, 2.4rem) 3rem;
  }
  .page-head { text-align: center; margin-bottom: 2.2rem; }
  .page-head h1 {
    color: var(--crimson);
    font-size: clamp(2.1rem, 5.5vw, 3.1rem);
    margin: 0.45rem 0 0;
    line-height: 1.05;
  }
  .intro {
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.6;
    margin: 1.1rem auto 0;
    max-width: 54ch;
  }
  .muted { color: var(--ink-soft); text-align: center; }

  .release {
    border-top: 1px solid var(--rule);
    padding: 1.5rem 0;
  }
  .release-head {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    flex-wrap: wrap;
    margin-bottom: 0.9rem;
  }
  .release-version {
    font-family: "AllByteCustom", "Trajan Pro", Georgia, serif;
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--crimson);
    margin: 0;
    letter-spacing: 0.02em;
  }
  .release-date { color: var(--ink-soft); font-size: 0.88rem; }
  .release-count {
    color: var(--gilt-deep);
    font-family: "AllByteCustom", Georgia, serif;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.7rem;
    margin-left: auto;
  }

  .group { margin: 0.6rem 0 0.9rem; }
  .group-label {
    font-family: "AllByteCustom", Georgia, serif;
    font-size: 0.72rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin: 0 0 0.35rem;
    color: var(--gilt-deep);
  }
  /* The two player-facing groups get the accent; engineering types stay quiet. */
  .group-feat { color: var(--crimson); }
  .group-fix  { color: var(--relic); }

  .changes { list-style: none; margin: 0; padding: 0; }
  .change {
    display: flex;
    gap: 0.55rem;
    align-items: baseline;
    padding: 0.2rem 0;
    font-size: 0.94rem;
    line-height: 1.55;
  }
  .change::before {
    content: "›";
    color: var(--gilt);
    flex: none;
  }
  .scope {
    flex: none;
    font-family: "AllByteCustom", Georgia, serif;
    color: var(--gilt-deep);
    background: var(--panel);
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 0 0.4rem;
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    align-self: center;
  }
  /* min-width:0 lets the flex item shrink; long test names / paths have no
     break opportunity, so break them rather than overflow the page. */
  .subject {
    color: var(--ink);
    min-width: 0;
    overflow-wrap: anywhere;
  }

  @media (max-width: 600px) {
    .release-count { display: none; }
  }
</style>
