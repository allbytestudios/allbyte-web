---
import ManualLayout from "../../layouts/ManualLayout.astro";
// devlog.css carries the draft-gating rules (.draft-post-content /
// .draft-gate / .draft-banner). It was previously imported ONLY by the hub, so
// this page shipped the gate markup with no CSS to enforce it and every draft
// post was fully readable at its direct URL. The import IS the gate.
import "../../styles/devlog.css";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  // All posts (including drafts) render in prod so admin can preview in place.
  // The post body is wrapped in .draft-post-content which CSS hides unless
  // body.is-admin is set by the client-side auth check in BaseLayout.
  const posts = await getCollection("devlogs");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const backHref = "/devlog/";
const categoryLabel = "Devlog";

const categoryLabels: Record<string, string> = {
  chronicles: "Chronicles of Nesis",
  "godot-and-claude": "Godot & Claude",
  studio: "AllByte Studios",
};
const seriesLabel = categoryLabels[post.data.devlog] ?? categoryLabel;
---

<ManualLayout
  title={`${post.data.title} — AllByte Studios`}
  description={post.data.description}
  active="/devlog/"
>
  <main class="article">
    {post.data.draft && (
      <div class="draft-banner">
        ⚠ DRAFT PREVIEW — visible to Hero+ subscribers. Text is still being revised and the published date will update on promotion.
      </div>
    )}
    {post.data.draft && (
      <div class="draft-gate">
        <h2>Draft post</h2>
        <p>This devlog entry is still in progress. Early access to drafts is a <strong>Hero</strong> tier perk.</p>
        <p><a href="/subscribe/">View subscription tiers →</a></p>
        <p><a href={backHref}>← Back to {categoryLabel}</a></p>
      </div>
    )}
    <article class:list={["content", post.data.draft && "draft-post-content"]}>
      <header class="article-header">
        <a class="back-link" href={backHref}>← {categoryLabel}</a>
        <div class="post-meta">
          <span class={`category-tag ${post.data.category}`}>{post.data.category}</span>
          <span class="series-tag">{seriesLabel}</span>
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
          </time>
        </div>
        <h1 class="post-title">{post.data.title}</h1>
        <p class="subtitle">{post.data.description}</p>
        {post.data.tags.length > 0 && (
          <div class="tags">
            {post.data.tags.map((tag: string) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )}
      </header>
      {headings.length > 0 && (
        <nav class="toc">
          <ul>
            {headings.filter((h) => h.depth <= 3).map((h) => (
              <li class={`toc-${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}
      <div class="post-content">
        <Content />
      </div>
    </article>
  </main>
  <script>
    // Render ```mermaid code blocks as SVG diagrams. Loaded on demand —
    // only runs when a devlog page actually has a .language-mermaid block.
    (async function renderMermaid() {
      // Astro/Shiki emits <pre data-language="mermaid"> (not <code class="language-mermaid">),
      // so match on the data-language attribute.
      const pres = document.querySelectorAll('pre[data-language="mermaid"]');
      if (!pres.length) return;
      const { default: mermaid } = await import(
        "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs"
      );
      mermaid.initialize({
        startOnLoad: false,
        theme: "dark",
        themeVariables: {
          primaryColor: "#12161c",
          primaryTextColor: "#e0e7ff",
          primaryBorderColor: "#a7f3d0",
          lineColor: "#a7f3d0",
          secondaryColor: "#1a1e26",
          tertiaryColor: "#22272e",
          fontFamily: "Courier New, monospace",
        },
        securityLevel: "loose",
      });
      let i = 0;
      for (const pre of pres) {
        // Shiki wraps each line in spans — textContent strips that back to raw source.
        const src = (pre.textContent || "").trim();
        const id = `mermaid-${++i}`;
        try {
          const { svg } = await mermaid.render(id, src);
          const wrap = document.createElement("div");
          wrap.className = "mermaid-diagram";
          wrap.innerHTML = svg;
          if (pre.parentElement) pre.parentElement.replaceChild(wrap, pre);
        } catch (err) {
          console.error("mermaid render failed:", err);
        }
      }
    })();
  </script>
</ManualLayout>

<style is:global>
  /* Repainted into the illuminated-manual system. Deliberate exception: fenced
     code blocks + mermaid diagrams stay on a DARK plate. Shiki emits per-token
     inline colors tuned for a dark background, so recoloring the plate to
     parchment would leave unreadable syntax highlighting. A dark inset panel on
     parchment reads as intentional; washed-out code does not. */
  .article {
    min-height: 100dvh;
    padding: 0 1rem 2rem;
  }

  .content {
    max-width: 760px;
    margin: 0 auto;
  }

  .article-header {
    margin-bottom: 3rem;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 2rem;
    padding-top: 2rem;
  }

  .back-link {
    display: inline-block;
    font-family: "AllByteCustom", Georgia, serif;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.72rem;
    color: var(--gilt-deep);
    text-decoration: none;
    margin-bottom: 1rem;
  }
  .back-link:hover { color: var(--crimson); }

  .post-title {
    font-family: "AllByteCustom", "Trajan Pro", Georgia, serif;
    font-size: clamp(1.9rem, 4.6vw, 2.7rem);
    font-weight: 400;
    color: var(--crimson);
    line-height: 1.1;
    margin: 0.6rem 0 0.5rem;
    text-wrap: balance;
  }

  .article-header .subtitle {
    font-size: 1.05rem;
    color: var(--ink-soft);
    line-height: 1.7;
    margin: 0 0 0.75rem;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }

  .post-meta time {
    font-family: "AllByteCustom", Georgia, serif;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
  }

  .toc {
    background: var(--panel);
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 0.9rem 1.25rem;
    margin-bottom: 2rem;
  }

  .toc ul { list-style: none; padding: 0; margin: 0; }

  .toc li {
    font-family: "Iowan Old Style", "Palatino Linotype", Georgia, serif;
    font-size: 0.94rem;
    line-height: 1.7;
    color: var(--ink);
  }

  .toc li.toc-3 { padding-left: 1.25rem; }

  .toc li::before {
    content: "—";
    color: var(--gilt);
    margin-right: 0.4rem;
  }

  .toc a { color: var(--ink); text-decoration: none; }
  .toc a:hover { color: var(--crimson); text-decoration: underline; }

  .post-content {
    font-family: "Iowan Old Style", "Palatino Linotype", "Book Antiqua", Georgia, serif;
    font-size: 1.08rem;
    line-height: 1.75;
    color: var(--ink);
  }

  .post-content h1, .post-content h2 {
    font-family: "AllByteCustom", "Trajan Pro", Georgia, serif;
    font-size: 1.55rem;
    font-weight: 400;
    color: var(--crimson);
    margin: 2.2rem 0 0.75rem;
  }

  .post-content h3 {
    font-family: "AllByteCustom", "Trajan Pro", Georgia, serif;
    font-size: 1.2rem;
    font-weight: 400;
    color: var(--gilt-deep);
    margin: 1.6rem 0 0.5rem;
  }

  .post-content p { margin: 0 0 1rem; }

  .post-content ul { padding-left: 1.5rem; margin: 0 0 1rem; list-style-type: disc; }
  .post-content ol { padding-left: 1.5rem; margin: 0 0 1rem; list-style-type: decimal; }
  .post-content li { margin-bottom: 0.4rem; }
  .post-content ::marker { color: var(--gilt); }

  .post-content strong { color: var(--ink); font-weight: 700; }

  /* Prose has no break opportunity inside long identifiers, paths, or URLs;
     break them on narrow screens rather than widening the page. */
  .post-content p,
  .post-content li {
    overflow-wrap: break-word;
  }

  /* Inline code sits IN the prose, so it takes the parchment treatment. */
  .post-content code {
    font-family: "Courier New", Courier, monospace;
    background: var(--panel);
    border: 1px solid var(--rule);
    color: var(--gilt-deep);
    padding: 0.1rem 0.35rem;
    font-size: 0.85em;
    border-radius: 2px;
    overflow-wrap: anywhere;
  }

  /* …but never break inside fenced blocks — those scroll instead. */
  .post-content pre code {
    overflow-wrap: normal;
  }

  .post-content pre {
    background: #12161c;
    border: 1px solid var(--gilt-deep);
    border-radius: 2px;
    padding: 1rem 1.25rem;
    margin: 1rem 0 1.5rem;
    overflow-x: auto;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.4);
  }

  .post-content pre code {
    background: none;
    border: 0;
    padding: 0;
    font-size: 0.85rem;
    line-height: 1.6;
    color: #e0e7ff;
  }

  .post-content a { color: var(--crimson); text-decoration: underline; text-underline-offset: 2px; }
  .post-content a:hover { color: var(--crimson-lt); }

  .post-content blockquote {
    border-left: 3px solid var(--gilt);
    margin: 1rem 0;
    padding: 0.5rem 1rem;
    color: var(--ink-soft);
    font-style: italic;
  }

  /* Scroll wide tables inside their own box instead of pushing the page
     sideways — auto table layout ignores width:100% when cells can't fit. */
  .post-content table {
    display: block;
    width: max-content;
    min-width: 100%;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 1rem 0 1.5rem;
    font-size: 0.94rem;
  }

  .post-content th {
    text-align: left;
    padding: 0.6rem 0.75rem;
    border-bottom: 2px solid var(--rule);
    font-family: "AllByteCustom", Georgia, serif;
    font-weight: 400;
    letter-spacing: 0.06em;
    color: var(--gilt-deep);
  }

  .post-content td {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
  }

  .mermaid-diagram {
    background: #12161c;
    border: 1px solid var(--gilt-deep);
    border-radius: 2px;
    padding: 1.25rem;
    margin: 1.5rem 0;
    text-align: center;
    overflow-x: auto;
  }
  .mermaid-diagram svg {
    max-width: 100%;
    height: auto;
    display: inline-block;
  }
</style>
