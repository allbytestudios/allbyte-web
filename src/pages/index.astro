---
import BaseLayout from "../layouts/BaseLayout.astro";
import NavAuth from "../components/NavAuth.svelte";
import HeroPlay from "../components/HeroPlay.svelte";
import RelicDeck from "../components/RelicDeck.svelte";
import EmailSignup from "../components/EmailSignup.svelte";
import { SIGNUP_ENABLED } from "../lib/emailSignup";
import gameVersion from "../data/game-version.json";
// The shared manual system (tokens, base type, nav, footer) — extracted from
// this file so /changelog/, /devlog/, /walkthrough/ and /artwork/ can use the
// same one. Homepage-only rules stay in the <style> block below.
import "../styles/manual.css";
---

<BaseLayout title="The Chronicles of Nesis | AllByte Studios" description="A world that has forgotten its heroes. Play The Chronicles of Nesis free in your browser, a handcrafted tactical RPG from AllByte Studios.">
  <div class="home">
<header class="nav"><div class="nav-in">
  <a class="brand" href="#play"><img class="brand-icon" src="/home/eed5218325.png" alt=""><span>AllByte</span></a>
  <nav class="links">
    <span class="navgroup"><a href="#play">The Chronicles of Nesis</a><a href="#pitch">Gameplay</a><a href="#creation">Characters</a><a href="#studio">Studio</a></span>
    <NavAuth client:load />
    <button class="theme-toggle" onclick="__abTheme.toggle(this)" aria-label="Toggle theme">☾</button>
  </nav>
</div></header>

<!-- HERO: the game -->
<div class="ghero" id="play"><div class="wrap">
  <div class="hero-stage">
    <div class="hero-plate hero-title-plate">
      <h1>The Chronicles of Nesis</h1>
      <div class="subtitle">A classic fantasy RPG, <br class="sub-br2">built in the spirit of 90s JRPGs, <br class="sub-br1">with the possibilities of modern technology.</div>
      <p class="hero-lede">Grid-based combat, a hand-built world, and the freedom to shape your journey.</p>
    </div>
    <div class="hero-frame frame"><img class="fl fl-tl" src="/home/95b8e10d61.png" alt=""><img class="fl fl-tr" src="/home/95b8e10d61.png" alt=""><img class="fl fl-bl" src="/home/95b8e10d61.png" alt=""><img class="fl fl-br" src="/home/95b8e10d61.png" alt=""><video class="hero-video" src="/home/frontroad-hero.mp4" poster="/home/frontroad-hero-poster.jpg" autoplay loop muted playsinline preload="auto" aria-label="Elias runs the front road of Laria — a parallax landscape of windmill, distant mountains, and a reflecting stream"></video></div>
    <div class="hero-plate hero-cta-plate">
      <div class="hero-banner-cta"><HeroPlay client:load /><a class="btn btn-ghost btn-lg" href="/manual/">Read the Manual</a></div>
      <p class="hero-cta-caption">No install. No account. Works on desktop, tablet, and phone.</p>
      <a class="hero-version" href="/changelog/">{gameVersion.version} &middot; What&rsquo;s new &rsaquo;</a>
    </div>
  </div>
</div></div>

<hr class="rule">

<!-- WHAT IT PLAYS LIKE -->
<section id="pitch"><div class="wrap">
  <div class="sec-head"><div class="eyebrow">The World of Nesis</div><h2>A World That Remembers the People History Forgot</h2><p class="lede">Trade routes have vanished. Kingdoms stand isolated. Ancient cities lie in ruins.</p><p class="lede">When Elias pulls a forgotten sword from an ancient grave, he begins a journey across Nesis to uncover what remains of a world slowly losing its past. Join Elias as he uncovers relics of the past, mastering new abilities while uncovering the forgotten stories woven into each one.</p></div>
  <div class="frow"><div class="shot frame"><img class="fl fl-tl" src="/home/95b8e10d61.png" alt=""><img class="fl fl-br" src="/home/95b8e10d61.png" alt=""><video src="/home/combat-section1.mp4" poster="/home/combat-section1-poster.jpg" autoplay loop muted playsinline preload="metadata" aria-label="Real tactical combat in a Waterway: a poisoned Elias attacks a VSlime that resists his physical blow — legible grid and full battle HUD"></video></div><div class="txt"><div class="fnum">I</div><h3>Tactical Combat</h3><p>Turn-based tactical battles where positioning is everything. Every unit, terrain tile, and status effect can change the outcome of a fight.</p></div></div>
  <div class="frow rev"><div class="shot frame"><img class="fl fl-tl" src="/home/95b8e10d61.png" alt=""><img class="fl fl-br" src="/home/95b8e10d61.png" alt=""><video src="/home/church-zoom.mp4" poster="/home/church-zoom-poster.jpg" autoplay loop muted playsinline preload="metadata" aria-label="Real in-game footage: exploring the church square, then the camera zooms straight into tactical combat as an enemy is engaged — no scene cut."></video></div><div class="txt"><div class="fnum">II</div><h3>Seamless Exploration &amp; Combat</h3><p>Wander villages, forests, and dungeons drawn entirely by hand. Enemies roam the same world you explore, and every encounter unfolds directly within the environment. Where you engage, how you approach, and the battlefield around you all become part of the strategy.</p></div></div>
  <div class="frow"><div class="shot frame"><img class="fl fl-tl" src="/home/95b8e10d61.png" alt=""><img class="fl fl-br" src="/home/95b8e10d61.png" alt=""><img src="/home/skilltree.jpg" alt="The skill tree, unlock nodes to grow each hero"></div><div class="txt"><div class="fnum">III</div><h3>Class Skill Trees</h3><p>Unlock permanent skills from each class tree and invest in the attributes that fit your strategy. Each hero retains their unique class identity while giving you the freedom to shape them to your playstyle.</p></div></div><div class="frow"><div class="txt"><div class="fnum">IV</div><h3>Relics of the Past</h3><p>Discover relics hidden throughout Nesis and wield them as powerful skills in battle. As your expertise grows, each relic reveals fragments of the story behind it, uncovering choices, sacrifices, and lives that shaped the world long before Elias's journey began.</p></div><div class="relic-visual"><RelicDeck client:visible /></div></div>
</div></section>

<hr class="rule">

<!-- CHARACTERS (animated) -->
<section id="creation"><div class="wrap">
  <div class="sec-head"><div class="eyebrow">Characters</div></div>
  <div class="cards3">
    <div class="charcard"><div class="charstage"><div class="sprite sm elias" role="img" aria-label="Elias"></div></div><h3>Elias</h3><p class="quote">“The strong are meant to help the weak.”</p></div>
    <div class="charcard"><div class="charstage"><div class="sprite sm falmri" role="img" aria-label="Falmri"></div></div><h3>Falmri</h3><p class="quote">“The right path is always simple… if you’re an idiot.”</p></div>
    <div class="charcard"><div class="charstage"><div class="sprite mia" role="img" aria-label="Mia"></div></div><h3>Mia</h3><p class="quote">“Fate is just an easy excuse for inaction.”</p></div>
  </div>
  <div style="text-align:center;margin-top:1.8rem"><a class="btn btn-ghost" href="/manual/#ch2">Meet the Characters</a></div>
</div></section>

<hr class="rule">

<!-- THE WORLD -->

<!-- STUDIO: small, at the bottom -->
<section id="studio" class="studio"><div class="wrap">
  <div class="studioline">
    <div class="eyebrow">The Studio Behind the World</div>
    <div class="who">AllByte Studios</div>
    <div class="tag">Building Big Worlds with Small Teams</div>
    <p class="sub">Independent games, open development, and the technology behind them, shared as they’re made.</p>
  </div>
  <div class="bts">
    <a class="btscard" href="/devlog/"><div class="sigil">✒</div><h4>Development Journal</h4><p>The decisions, dead ends, and breakthroughs behind the game.</p><span class="cta">Read Devlogs</span></a>
    <a class="btscard" href="/artwork/"><div class="sigil">✦</div><h4>Art &amp; Music Collection</h4><p>Sprites, soundtrack, font design, and visual development. Handcrafted.</p><span class="cta">Explore</span></a>
    <a class="btscard" href="/test/"><div class="sigil">⚙</div><h4>Builder’s Workshop <span class="relic-dot"></span></h4><p>Tools, systems, and architecture behind The Chronicles of Nesis.</p><span class="cta">Enter</span></a>
  </div>
</div></section>

{SIGNUP_ENABLED && (
  <section id="notify"><div class="wrap">
    <div class="notify-band">
      <EmailSignup
        client:visible
        source="home"
        variant="paper"
        heading="Told when there's more"
        blurb="Episode 1 is free to play right now. Get notified when the next episode releases."
        cta="Notify me"
      />
    </div>
  </div></section>
)}

<footer><div class="wrap">
  <div class="fnav"><a href="/play/">Play</a><a href="#pitch">Gameplay</a><a href="#creation">Characters</a><a href="/manual/">Manual</a><a href="/walkthrough/">Strategy Guide</a><a href="#studio">Studio</a></div>
  <div class="cr">The Chronicles of Nesis · © AllByte Studios · Made and shared in the open.</div>
</div>

</footer>
  </div>
</BaseLayout>

<style is:global>


  /* HERO — the game, front & center */
  .ghero{ text-align:center; padding:clamp(.7rem,1.6vw,1.2rem) 0 clamp(.7rem,1.6vw,1.1rem); }
  .ghero .kick{ font-family:"AllByteCustom",Georgia,serif; text-transform:uppercase; letter-spacing:.22em; font-size:.8rem; color:var(--gilt-deep); }
  .ghero h1{ color:var(--crimson); text-wrap:balance; font-size:clamp(2.8rem,8vw,5rem); margin:.4rem 0 .12rem; line-height:1.02; -webkit-text-stroke:2px #45120d; text-stroke:2px #45120d; paint-order:stroke fill; text-shadow:0 1px 0 rgba(255,247,224,.32),0 3px 7px rgba(0,0,0,.22); }
  .ghero .subtitle{ font-family:"AllByteCustom",Georgia,serif; color:var(--ink); font-size:clamp(1.05rem,2.05vw,1.3rem); letter-spacing:.015em; line-height:1.5; margin:.5rem auto 0; text-shadow:0 1px 0 rgba(255,247,224,.5); }
  .ghero .subtitle .sub-br2{ display:none; }
  @media (max-width:600px){ .ghero .subtitle .sub-br2{ display:inline; } }
  /* sub-br1 (break before "with…") shows below desktop; on desktop (>=768px)
     the subtitle flows to 1-2 lines instead of a forced 2-line split. */
  .ghero .subtitle .sub-br1{ display:inline; }
  @media (min-width:768px){ .ghero .subtitle .sub-br1{ display:none; } }
  .ghero .hero-lede{ max-width:60ch; margin:.7rem auto 0; color:var(--ink-soft); font-size:clamp(.98rem,1.7vw,1.1rem); line-height:1.55; }
  @media (min-width:768px){ .ghero .hero-lede{ max-width:78ch; } }
  /* HERO STAGE — the video sizes as large as it fits; title + CTA are PLATES.
     Mobile: stacked (title above the video, CTA below — there's vertical room).
     Desktop (>=768px): the video fills the viewport and the plates FLOAT over its
     top and bottom (overlapping it), always on top + visible. */
  .hero-stage{ position:relative; width:100%; max-width:960px; margin:1.1rem auto 0; display:flex; flex-direction:column; align-items:center; }
  .hero-frame{ order:2; position:relative; width:100%; max-width:100%; padding:6px; background:var(--panel); box-shadow:0 12px 34px var(--shadow); }
  .hero-frame > .fl{ width:clamp(58px,9vw,104px); height:clamp(58px,9vw,104px); }
  .hero-video{ display:block; width:100%; height:auto; aspect-ratio:1200/870; border-radius:2px; }
  @media (prefers-reduced-motion:reduce){ .hero-video{ transition:none; } }
  .hero-title-plate{ order:1; margin-bottom:.55rem; }
  .hero-cta-plate{ order:3; width:min(94%,600px); margin-top:.9rem; display:flex; flex-direction:column; align-items:center; gap:.55rem; }
  .hero-cta-caption{ font-family:"AllByteCustom",Georgia,serif; color:var(--gilt-deep); font-size:clamp(.82rem,1.3vw,.95rem); letter-spacing:.02em; margin:0; }
  .hero-banner-cta{ display:flex; gap:.8rem; flex-wrap:wrap; justify-content:center; align-items:stretch; width:100%; }
  .hero-banner-cta > .btn{ flex:1 1 0; justify-content:center; }
  .hero-banner-cta :global(.heroplay){ flex:1 1 0; }
  .hero-version{ font-family:"AllByteCustom",Georgia,serif; text-transform:uppercase; letter-spacing:.12em; font-size:.72rem; color:var(--gilt-deep); text-decoration:none; }
  .hero-version:hover{ color:var(--crimson); text-decoration:underline; }
  @media (min-width:768px){
    .hero-stage{ display:block; width:fit-content; max-width:100%; }
    .hero-frame{ width:fit-content; max-width:100%; margin:0 auto; }
    .hero-video{ width:auto; max-width:100%; max-height:calc(100dvh - 250px); margin:0 auto; }
    /* plates are always LIGHT parchment, so force light-theme text/trim colors
       (in dark mode the theme vars would be light-on-dark = illegible here) */
    .hero-plate{ position:absolute; left:50%; transform:translateX(-50%); z-index:2; width:min(82%,560px); margin:0; padding:.8rem 1.25rem; border-radius:3px; background:linear-gradient(rgba(245,236,210,.93),rgba(240,229,198,.93)); border:1px solid var(--gilt-lt); box-shadow:0 10px 26px rgba(0,0,0,.5),inset 0 0 0 1px rgba(255,247,224,.22); --ink:#3a2c1b; --ink-soft:#6a5836; --crimson:#8a2b21; --crimson-lt:#a8412f; --gilt:#9a7736; --gilt-lt:#c8a24e; --gilt-deep:#7a5c22; --rule:rgba(122,92,34,.55); }
    .hero-plate::before{ content:""; position:absolute; inset:4px; border:1px solid var(--rule); border-radius:2px; pointer-events:none; }
    .hero-title-plate{ top:clamp(10px,2.4vh,24px); margin:0; }
    .hero-cta-plate{ bottom:clamp(10px,2.4vh,24px); margin:0; }
    .hero-title-plate h1{ font-size:clamp(1.8rem,4vw,2.9rem); margin:.1rem 0; -webkit-text-stroke-width:1.5px; text-stroke-width:1.5px; }
    .hero-title-plate .subtitle{ font-size:clamp(.9rem,1.5vw,1.06rem); margin-top:.3rem; }
    .hero-title-plate .hero-lede{ font-size:clamp(.82rem,1.2vw,.95rem); max-width:50ch; margin-top:.35rem; }
  }
  .ghero .cta{ display:flex; gap:.9rem; justify-content:center; flex-wrap:wrap; margin-top:1.5rem; align-items:center; }
  .ghero .trust{ display:block; margin-top:.9rem; font-size:.86rem; color:var(--ink-soft); letter-spacing:.02em; }

  section{ padding:clamp(1.5rem,3.5vw,2.6rem) 0; position:relative; }
  .sec-head{ text-align:center; margin-bottom:2.2rem; }
  .sec-head h2{ font-size:clamp(1.9rem,4.5vw,2.9rem); margin:.5rem 0 .3rem; color:var(--crimson); }
  .sec-head .sec-sub{ font-family:"AllByteCustom",Georgia,serif; color:var(--gilt-deep); font-size:clamp(1rem,2vw,1.25rem); letter-spacing:.01em; margin:0 auto .7rem; max-width:36ch; }
  .lede{ max-width:74ch; margin:0 auto; color:var(--ink-soft); font-size:1.1rem; }
  .sec-head .lede + .lede{ margin-top:.7rem; }

  /* WHAT IT PLAYS LIKE — alternating feature rows w/ screenshots */
  .frow{ display:flex; flex-direction:column; align-items:center; gap:1.3rem; max-width:820px; margin:0 auto; }
  .frow + .frow{ margin-top:clamp(2.4rem,5vw,3.6rem); padding-top:clamp(2.4rem,5vw,3.6rem); border-top:1px solid var(--rule); }
  .frow:last-child{ margin-bottom:0; }
  .frow .txt{ order:0; text-align:center; max-width:62ch; }
  .frow .shot{ order:1; width:100%; padding:6px; background:var(--panel); }
  .frow .shot img:not(.fl), .frow .shot video{ width:100%; display:block; }
  .frow .relic-visual{ width:100%; display:flex; justify-content:center; }
  /* Section II uses the REAL in-game church explore->combat zoom video now
     (.frow .shot video above); the former CSS Ken Burns crossfade was retired. */
  .frow h3{ color:var(--crimson); font-size:clamp(1.5rem,3.5vw,2.1rem); margin:.1rem 0 .5rem; }
  .frow p{ font-size:1.08rem; color:var(--ink); margin:0; }
  .frow .fnum{ font-family:"AllByteCustom",Georgia,serif; color:var(--gilt); letter-spacing:.1em; font-size:.8rem; }
  @media (max-width:720px){ .frow{ gap:1rem; } .frow + .frow{ margin-top:2rem; padding-top:2rem; } }

  /* EXPLORE NESIS — animated character sprites */
  .cards3{ display:grid; grid-template-columns:repeat(3,1fr); gap:1.3rem; margin-top:1.4rem; }
  .charcard{ background:var(--panel); border:1px solid var(--rule); box-shadow:inset 0 0 0 3px var(--paperblend); border-radius:2px; padding:1.7rem 1.2rem 1.5rem; text-align:center; transition:transform .18s,box-shadow .2s; }
  .charcard:hover{ transform:translateY(-4px); box-shadow:inset 0 0 0 3px var(--paperblend),0 12px 28px var(--shadow); }
  .charstage{ height:158px; margin:0 auto 1rem; display:flex; align-items:flex-end; justify-content:center; position:relative; border-radius:9px 9px 2px 2px; background:radial-gradient(120% 92% at 50% 12%,rgba(47,143,122,.12),transparent 62%); box-shadow:inset 0 0 0 1px var(--gilt-lt),inset 0 0 0 4px var(--panel),inset 0 0 0 5px var(--rule); overflow:hidden; }
  .charstage::after{ content:""; position:absolute; bottom:16px; left:50%; width:74px; height:12px; transform:translateX(-50%); border-radius:50%; background:radial-gradient(ellipse at center,rgba(0,0,0,.30),transparent 72%); }
  .sprite{ position:relative; z-index:1; margin-bottom:16px; image-rendering:pixelated; background-repeat:no-repeat; filter:drop-shadow(0 2px 3px rgba(0,0,0,.38)); }
  .sprite.sm{ width:88px; height:88px; background-size:528px 88px; }
  .sprite.mia{ width:128px; height:128px; background-size:768px 128px; }
  .charcard:hover .sprite.sm{ animation:walk .82s steps(6) infinite; }
  .charcard:hover .sprite.mia{ animation:walkmia .82s steps(6) infinite; }
  @media (prefers-reduced-motion:reduce){ .charcard:hover .sprite.sm,.charcard:hover .sprite.mia{ animation:none; } }
  @keyframes walk{ to{ background-position-x:-528px; } }
  @keyframes walkmia{ to{ background-position-x:-768px; } }
  .sprite.elias{ background-image:url("/home/2e357dffa1.png"); } .sprite.falmri{ background-image:url("/home/5b7344d4ff.png"); } .sprite.mia{ background-image:url("/home/22fc6ef1a3.png"); }
  .charcard h3{ color:var(--crimson); font-size:1.55rem; margin:0 0 .4rem; } .charcard .quote{ color:var(--ink-soft); font-style:italic; font-size:.98rem; }
  @media (max-width:680px){ .cards3{ grid-template-columns:1fr; max-width:340px; margin-inline:auto; } }

  .illum{ font-size:1.15rem; }
  .illum::first-letter{ font-family:"AllByteCustom",Georgia,serif; float:left; font-size:4.4rem; line-height:.72; margin:.35rem .7rem .1rem 0; padding:.32rem .42rem .18rem; color:#f7edcf; background:linear-gradient(150deg,var(--crimson),#5f1b14); border:2px solid var(--gilt-lt); box-shadow:0 2px 8px var(--shadow),inset 0 0 0 1px rgba(200,162,78,.5); text-shadow:0 1px 2px rgba(0,0,0,.5); }
  .world{ display:grid; grid-template-columns:1.08fr .92fr; gap:clamp(1.5rem,4vw,3rem); align-items:center; }
  .world .map{ padding:6px; background:var(--panel); } .world .cta{ display:flex; gap:.8rem; margin-top:1.2rem; flex-wrap:wrap; }
  @media (max-width:760px){ .world{ grid-template-columns:1fr; } .illum::first-letter{ float:none; display:inline-block; } }

  /* STUDIO — small, at the very bottom */
  .studio{ background:linear-gradient(var(--paperblend),var(--paperblend)); padding:clamp(2.2rem,4vw,3rem) 0; }
  /* Notify band: deliberately a quiet strip near the foot, NOT a modal or a
     popup. The homepage's whole job is getting someone into the game, and an
     interstitial that interrupts that trades play-depth for addresses. */
  #notify{ padding:clamp(1.8rem,3.5vw,2.6rem) 0; border-top:1px solid var(--rule); }
  .notify-band{ display:flex; justify-content:center; text-align:center; }
  .notify-band :global(.signup){ margin:0 auto; }
  .notify-band :global(.row){ justify-content:center; }
  .studioline{ text-align:center; }
  .studioline .who{ font-family:"AllByteCustom",Georgia,serif; color:var(--crimson); font-size:1.7rem; }
  .studioline .tag{ font-family:"AllByteCustom",Georgia,serif; color:var(--gilt-deep); letter-spacing:.03em; font-size:1.05rem; margin-top:.15rem; }
  .studioline .sub{ color:var(--ink-soft); max-width:52ch; margin:.6rem auto 0; font-size:.98rem; }
  .bts{ display:grid; grid-template-columns:repeat(3,1fr); gap:1.1rem; margin-top:1.8rem; }
  .btscard{ display:block; text-decoration:none; color:inherit; cursor:pointer; background:var(--panel); border:1px solid var(--rule); box-shadow:inset 0 0 0 3px var(--paperblend); border-radius:2px; padding:1.3rem 1.3rem; transition:transform .18s,box-shadow .2s; }
  .btscard:hover{ transform:translateY(-3px); box-shadow:inset 0 0 0 3px var(--paperblend),0 10px 24px var(--shadow); }
  .btscard .sigil{ font-size:1.4rem; color:var(--gilt); } .btscard h4{ font-family:"AllByteCustom",Georgia,serif; color:var(--ink); font-size:1.34rem; letter-spacing:.01em; margin:.4rem 0 .35rem; }
  .btscard p{ color:var(--ink); font-size:.94rem; line-height:1.5; margin:0 0 .8rem; }
  .btscard .cta{ display:inline-block; font-family:"AllByteCustom",Georgia,serif; text-transform:uppercase; letter-spacing:.08em; font-size:.84rem; color:var(--crimson); border-bottom:1px solid var(--gilt); }
  .btscard:hover .cta{ border-bottom-color:var(--crimson); }
  .btscard:focus-visible{ outline:2px solid var(--crimson); outline-offset:3px; }
  .relic-dot{ display:inline-block; width:8px; height:8px; border-radius:50%; background:var(--relic); vertical-align:middle; margin-left:.35rem; animation:pulse 2.6s ease-out infinite; }
  @keyframes pulse{ 0%{ box-shadow:0 0 0 0 color-mix(in srgb,var(--relic) 60%,transparent);} 70%{ box-shadow:0 0 0 9px transparent;} 100%{ box-shadow:0 0 0 0 transparent;} }
  @media (max-width:760px){ .bts{ grid-template-columns:1fr; } }

  .note{ max-width:1080px; margin:1.4rem auto 0; padding:.9rem 1.1rem; border:1px dashed var(--rule); border-radius:2px; font-size:.86rem; color:var(--ink-soft); background:var(--panel); }
  @media (prefers-reduced-motion:reduce){ *{ animation:none!important; transition:none!important; } }

</style>
