---
import BaseLayout from "../layouts/BaseLayout.astro";
import GodotEmbed from "../components/GodotEmbed.svelte";

const fixture = Astro.url.searchParams.get("fixture") ?? undefined;
---

<BaseLayout
  title="The Chronicles of Nesis | AllByte Studios"
  ogTitle="The Chronicles of Nesis"
  description="A handcrafted tactical RPG in the spirit of 90s JRPGs. Play in your browser — no install, no account."
  image="/og-play.jpg"
>

  <main class="play-page">
    {fixture && <span class="fixture-label">Fixture: {fixture}</span>}
    <GodotEmbed client:load {fixture} />
  </main>

  <!--
    STUDIO BIT ANIMATION — generated here, at parse time, deliberately.

    Booting the game blocks the main thread for a very long time: measured on
    prod, a single 8.8-SECOND long task while the WASM compiles. Anything driven
    by setTimeout or requestAnimationFrame simply stops for that window, which is
    what made the bits freeze mid-scramble and the whole scene overstay by ~9s.

    So the sequence is emitted as pure CSS keyframes instead. Two consequences,
    both of which are the point:
      1. It starts when the element PAINTS, not at hydration — hydration is
         itself a main-thread task that can land seconds late.
      2. Opacity keyframes on promoted layers run on the COMPOSITOR, so they
         keep playing while the main thread is wedged.
    The landing value is still random per load because this runs per page view.

    Constants mirror BITS_* in GodotEmbed.svelte — change one, change both.
  -->
  <script is:inline>
    (function () {
      var FAST = 42, FAST_UNTIL = 980, SETTLE_AT = 1280, DECEL = 270;
      var TOTAL = 2000, N = 8;
      // Flip times, sharing the component's converge curve.
      var times = [], t = 0;
      while (t < SETTLE_AT) {
        times.push(t);
        var k = t < FAST_UNTIL ? 0 : (t - FAST_UNTIL) / (SETTLE_AT - FAST_UNTIL);
        t += FAST + k * k * DECEL;
      }
      var pct = function (ms) { return (ms / TOTAL * 100).toFixed(3) + "%"; };
      var css = "";
      for (var i = 0; i < N; i++) {
        var zero = "", one = "";
        for (var f = 0; f < times.length; f++) {
          var on = Math.random() < 0.5 ? 1 : 0;      // this bit's value at this step
          zero += pct(times[f]) + "{opacity:" + (on ? 0 : 1) + "}";
          one  += pct(times[f]) + "{opacity:" + (on ? 1 : 0) + "}";
        }
        // The landed value: held from SETTLE_AT to the end of the scene.
        var land = Math.random() < 0.5 ? 1 : 0;
        zero += pct(SETTLE_AT) + "{opacity:" + (land ? 0 : 1) + "}";
        one  += pct(SETTLE_AT) + "{opacity:" + (land ? 1 : 0) + "}";
        css += "@keyframes abz" + i + "{" + zero + "}";
        css += "@keyframes abo" + i + "{" + one + "}";
        css += ".ab-b" + i + ".ab-0{animation:abz" + i + " " + TOTAL + "ms step-end both}";
        css += ".ab-b" + i + ".ab-1{animation:abo" + i + " " + TOTAL + "ms step-end both}";
      }
      // Pick which manual card the load screen opens on. Done HERE, at parse
      // time, for the same reason as the bits: the choice must not wait on
      // hydration, and it must still be random per load rather than frozen at
      // build. The count is read from the markup so adding a card needs no
      // change here.
      var cards = document.querySelectorAll(".dom-card-item");
      if (cards.length) {
        var pick = Math.floor(Math.random() * cards.length);
        css += '.dom-cards .dom-card-item[data-i="' + pick + '"]{display:flex}';
        // Tell the worker to open on the SAME card, so its later takeover is a
        // continuation rather than a visible content swap.
        window.__abLoadCard = pick;
      }

      var s = document.createElement("style");
      s.id = "ab-bitseq";
      s.textContent = css;
      document.head.appendChild(s);
    })();
  </script>
</BaseLayout>

<!--
  /play/ is the PWA's start_url and the standalone fullscreen game route.
  No back button, no header — the game owns its own chrome (Back is
  synonymous with Quit in-game, per owner spec). Desktop users can still
  use the browser back button or close the tab; PWA users close the
  window. Once Arc ships the in-game quit it'll post
  allbyte:request-exit which the save bridge handles.

  SharedArrayBuffer headers (COOP same-origin + COEP require-corp) are
  served by CloudFront in prod and by src/middleware.js in dev. Required
  for Godot HTML5 cross-origin isolation.
-->

<style>
  /* Reset body defaults so the play page can sit flush against the
     viewport edges. Without this, body's default 8px margin would push
     the play container 8px down and 8px right, and the matching 8px on
     the bottom edge gets clipped — the "20px off at the bottom" the owner
     was seeing on mobile. Scoped via :global() to this page only. */
  :global(html),
  :global(body) {
    margin: 0;
    padding: 0;
  }

  /* Fixed-positioned so the play container is pinned to viewport corners,
     bypassing any residual padding/margin in ancestor elements (Astro
     wrappers, Footer-related layout, etc.). dvh would still be subject
     to body offsets; inset:0 is layout-immune. */
  .play-page {
    background: #0a0e17;
    position: fixed;
    inset: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .fixture-label {
    position: absolute;
    top: 0.4rem;
    left: 0.5rem;
    z-index: 50;
    color: #fbbf24;
    font-family: "Courier New", monospace;
    font-size: 0.72rem;
    padding: 0.18rem 0.4rem;
    border: 1px solid rgba(251, 191, 36, 0.3);
    border-radius: 3px;
    background: rgba(10, 14, 23, 0.7);
    pointer-events: none;
  }
</style>
