---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import PageHeader from "../components/PageHeader.astro";

const title = "Subscribe — AllByte Studios";
const description = "Support AllByte Studios and unlock minor version release builds, full asset access, and deep Dev Console inspection.";

// Tiers are hosted on Patreon (campaign 16252801). Pledging happens on
// Patreon; the site reads your membership when you log in with Patreon.
const PATREON_LOGIN = "https://api.allbyte.studio/auth/oauth/patreon";
const tiers = [
  {
    name: "Initiate",
    price: 3,
    color: "#a7f3d0",
    patreonUrl: "https://www.patreon.com/checkout/AllByteStudios?rid=28882017",
    features: [
      "Beta and beyond — every post-Alpha build as it ships (Alpha stays free for everyone)",
      "All game assets unlocked",
    ],
  },
  {
    name: "Hero",
    price: 7,
    color: "#fbbf24",
    patreonUrl: "https://www.patreon.com/checkout/AllByteStudios?rid=28882292",
    features: [
      "Everything in Initiate",
      "Deep test suite inspection — per-test history, screenshots, live workers",
      "Early access to devlog drafts",
    ],
  },
  {
    name: "Legend",
    price: 15,
    color: "#f97316",
    patreonUrl: "https://www.patreon.com/checkout/AllByteStudios?rid=28882311",
    features: [
      "Everything in Hero",
      "Debug builds — in-game dev tools + debug HUD (Alpha & Beta)",
      "Worker history — full agent task logs and durations",
      "Ticket backlog — P3/deferred priorities and subtask detail",
    ],
  },
];
---

<BaseLayout title={title} description={description}>
  <div class="page">
    <PageHeader theme="engine" title="Support the Studio" backHref="/" backLabel="Home" />

    <main class="content">
      <section class="support-intro">
        <p class="intro-lead">
          <em>The Chronicles of Nesis</em> is free to play, and it stays free
          through the Alpha release.
        </p>
        <p>
          I built it solo, and I host it myself on AWS &mdash; right now about
          <strong>$15 a month</strong>. If you&rsquo;d like to help keep it online,
          becoming a patron is the most direct way to keep the servers running.
        </p>
        <p class="intro-value">
          Patrons (<strong>Initiate</strong> and up) also unlock everything after
          Alpha as I port it in &mdash; so your support keeps the game online today
          <em>and</em> gets you what&rsquo;s coming next. Curious where it goes?
          Here&rsquo;s the <a href="/self-hosting-with-claude/">self-hosted stack and
          its costs</a>.
        </p>
      </section>

      <div class="tiers">
        {tiers.map(tier => (
          <div class:list={["tier-card", { featured: tier.featured }]} style={`--tier-color: ${tier.color}`}>
            {tier.featured && <span class="featured-badge">Most Popular</span>}
            <h2 class="tier-name">{tier.name}</h2>
            <div class="tier-price">
              <span class="price-amount">${tier.price}</span>
              <span class="price-period">/month</span>
            </div>
            <ul class="tier-features">
              {tier.features.map(f => (
                <li>{f}</li>
              ))}
            </ul>
            <a class="tier-btn" href={tier.patreonUrl} target="_blank" rel="noopener noreferrer">Become a patron</a>
          </div>
        ))}
      </div>

      <div class="support-section">
        <h2 class="support-title">Already a patron?</h2>
        <p class="support-body">
          Pledges are handled on Patreon. Once you've joined a tier, log in with
          Patreon here to unlock your build access, asset downloads, and Dev
          Console inspection — your tier syncs automatically.
        </p>
        <a class="patreon-login-btn" href={PATREON_LOGIN}>Log in with Patreon</a>
      </div>

      <div class="faq-section">
        <h2 class="faq-title">How it works</h2>
        <div class="faq-grid">
          <div class="faq-item">
            <h3>When do I get access?</h3>
            <p>Join a tier on Patreon, then log in with Patreon here. Your tier syncs on login and updates automatically whenever your pledge changes.</p>
          </div>
          <div class="faq-item">
            <h3>Can I change tiers?</h3>
            <p>Upgrade or downgrade anytime from your Patreon account. The change syncs here automatically — no extra step on the site.</p>
          </div>
          <div class="faq-item">
            <h3>What's a minor version release build?</h3>
            <p>Each minor version (0.4.x → 0.5.0) ships a playable build with the latest features. Subscribers get access to these as they land, ahead of the public demo.</p>
          </div>
          <div class="faq-item">
            <h3>What's in the Dev Console?</h3>
            <p>Live status of every test suite, agent, and ticket — the same dashboard I use to run the studio. Hero unlocks per-test history, screenshots, and live worker views. Legend adds full agent task logs and the deferred ticket backlog.</p>
          </div>
        </div>
      </div>
    </main>

    <Footer theme="engine" />
  </div>
  <!--
    No checkout script: pledging happens on Patreon (the "Become a patron"
    links), and the "Log in with Patreon" link starts OAuth. The returned
    JWT (#token=...) is consumed globally by initAuth in BaseLayout.
  -->
</BaseLayout>

<style is:global>
  .page {
    min-height: 100dvh;
    background: #0d1117;
    display: flex;
    flex-direction: column;
    color: #e0e7ff;
  }


  .content {
    flex: 1;
    max-width: 1000px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem;
    width: 100%;
    box-sizing: border-box;
  }

  .support-intro {
    max-width: 46rem;
    margin: 0 auto 2.5rem;
    text-align: center;
    line-height: 1.7;
  }

  .support-intro p {
    color: rgba(224, 231, 255, 0.85);
    margin: 0 0 1rem;
  }

  .support-intro .intro-lead {
    font-size: 1.25rem;
    color: #e0e7ff;
  }

  .support-intro .intro-value {
    border-left: 3px solid #a7f3d0;
    padding-left: 1rem;
    text-align: left;
    color: #e0e7ff;
  }

  .support-intro strong {
    color: #fff;
  }

  .support-intro a {
    color: #a7f3d0;
  }

  .tiers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  .tier-card {
    background: #1a1e26;
    border: 1px solid rgba(224, 231, 255, 0.1);
    border-radius: 6px;
    padding: 2rem 1.5rem;
    text-align: center;
    position: relative;
    transition: border-color 0.2s;
  }

  .tier-card:hover {
    border-color: var(--tier-color);
  }

  .tier-card.featured {
    border-color: var(--tier-color);
    box-shadow: 0 0 24px rgba(251, 191, 36, 0.1);
    transform: scale(1.03);
  }

  .featured-badge {
    position: absolute;
    top: -0.75rem;
    left: 50%;
    transform: translateX(-50%);
    background: var(--tier-color);
    color: #0d1117;
    font-family: "Courier New", monospace;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.25rem 0.75rem;
    border-radius: 3px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .tier-name {
    font-family: "AllByteCustom", Georgia, "Times New Roman", serif;
    font-size: 1.75rem;
    color: var(--tier-color);
    margin: 0 0 0.75rem;
  }

  .tier-price {
    margin-bottom: 1.5rem;
  }

  .price-amount {
    font-family: "AllByteCustom", Georgia, "Times New Roman", serif;
    font-size: 2.5rem;
    color: #e0e7ff;
  }

  .price-period {
    font-family: "Courier New", monospace;
    font-size: 0.9rem;
    color: rgba(224, 231, 255, 0.4);
  }

  .tier-features {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    text-align: left;
  }

  .tier-features li {
    font-family: "Courier New", monospace;
    font-size: 0.9rem;
    color: rgba(224, 231, 255, 0.7);
    padding: 0.4rem 0;
    border-bottom: 1px solid rgba(224, 231, 255, 0.05);
  }

  .tier-features li::before {
    content: "✓ ";
    color: var(--tier-color);
    font-weight: 700;
  }

  .tier-btn {
    font-family: "AllByteCustom", Georgia, "Times New Roman", serif;
    font-size: 1.1rem;
    display: block;
    box-sizing: border-box;
    width: 100%;
    padding: 0.7rem;
    border: 1px solid var(--tier-color);
    background: transparent;
    color: var(--tier-color);
    cursor: pointer;
    border-radius: 4px;
    text-align: center;
    text-decoration: none;
    transition: all 0.2s;
  }

  .tier-btn:hover:not(:disabled) {
    background: var(--tier-color);
    color: #0d1117;
  }

  .tier-btn:disabled {
    opacity: 0.7;
    cursor: wait;
  }

  .support-section {
    margin-top: 3rem;
    text-align: center;
    padding: 1.75rem 2rem;
    background: #12161c;
    border: 1px solid rgba(167, 243, 208, 0.15);
    border-radius: 6px;
  }

  .support-title {
    font-family: "AllByteCustom", Georgia, "Times New Roman", serif;
    font-size: 1.5rem;
    color: #a7f3d0;
    margin: 0 0 0.75rem;
  }

  .support-body {
    font-family: "Courier New", monospace;
    font-size: 0.95rem;
    line-height: 1.7;
    color: rgba(224, 231, 255, 0.75);
    margin: 0 auto;
    max-width: 620px;
  }

  .patreon-login-btn {
    display: inline-block;
    margin-top: 1.25rem;
    font-family: "AllByteCustom", Georgia, "Times New Roman", serif;
    font-size: 1.05rem;
    padding: 0.6rem 1.6rem;
    background: #ff424d;
    color: #fff;
    border-radius: 4px;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .patreon-login-btn:hover {
    opacity: 0.88;
  }

  .faq-section {
    margin-top: 3rem;
  }

  .faq-title {
    font-family: "AllByteCustom", Georgia, "Times New Roman", serif;
    font-size: 1.75rem;
    color: #e0e7ff;
    margin: 0 0 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(224, 231, 255, 0.1);
  }

  .faq-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .faq-item {
    background: #1a1e26;
    border: 1px solid rgba(224, 231, 255, 0.08);
    border-radius: 4px;
    padding: 1.25rem;
  }

  .faq-item h3 {
    font-family: "AllByteCustom", Georgia, "Times New Roman", serif;
    font-size: 1.1rem;
    color: #a7f3d0;
    margin: 0 0 0.5rem;
  }

  .faq-item p {
    font-family: "Courier New", monospace;
    font-size: 0.85rem;
    color: rgba(224, 231, 255, 0.6);
    margin: 0;
    line-height: 1.5;
  }

  .page-footer {
    background: #1a1e26;
    text-align: center;
    padding: 1.5rem 1rem;
  }

  @media (max-width: 768px) {
    .tiers {
      grid-template-columns: 1fr;
      max-width: 400px;
      margin: 0 auto;
    }

    .tier-card.featured {
      transform: none;
    }

    .faq-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
