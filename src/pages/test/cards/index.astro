---
import ConsoleLayout from "../../../layouts/ConsoleLayout.astro";
import { MANUAL_CARDS, SPRITE_LORE } from "../../../lib/manualCards.ts";
import contentVersions from "../../../data/content-versions.json";
import gameVersion from "../../../data/game-version.json";

// Cards and booklet document the EPISODE ONE DESIGN, not the deployed build
// (owner, 2026-09-08) — the game catches up to them. So the useful signal here
// is not "is this content behind the game" but "what has the game not caught up
// with yet": a to-do for the game, not a defect in the content.
const cards = contentVersions.cards;
const manual = contentVersions.manual;
const liveGame = String(gameVersion.version || "").replace(/^v/, "");
const ahead = [
  ...(manual.aheadOfLive ?? []).map((a) => ({ ...a, where: "Booklet" })),
  ...(cards.aheadOfLive ?? []).map((a) => ({ ...a, where: "Cards" })),
];
// The inverse of aheadOfLive: places the booklet is right and the BUILD is
// wrong. Listed because the failure mode under a design-spec model is someone
// noticing the mismatch and "correcting" the booklet into documenting a bug.
const defects = (contentVersions as any).divergences ?? [];

// Order the sprite lore the same way the display names read.
const spriteEntries = Object.entries(SPRITE_LORE);
const rowCount = MANUAL_CARDS.reduce((n, c) => n + (c.rows?.length ?? c.lines?.length ?? 0), 0);
---

<ConsoleLayout
  title="Loading Cards — Dev Console — AllByte Studios"
  description="Every /play load-screen manual card, rendered from the same source the loader uses."

  active="cards"
>
  <main class="cards-shell">

    <div class="cards-wrap">
      <header class="cards-head">
        <h1>Loading Cards</h1>
        <p>
          Every manual card shown on the <code>/play</code> load screen, rendered from
          <code>src/lib/manualCards.ts</code> — the exact source the loader draws, so
          this can't drift from what players see.
        </p>
        <div class={`vbar ${ahead.length ? "vbar-ahead" : "vbar-ok"}`}>
          <div class="vitem">
            <span class="vlabel">Cards</span>
            <b>{cards.version}</b>
            <span class="vsub">{cards.target} · reviewed {cards.reviewed}</span>
          </div>
          <div class="vitem">
            <span class="vlabel">Booklet</span>
            <b>{manual.version}</b>
            <span class="vsub">{manual.target} · reviewed {manual.reviewed}</span>
          </div>
          <div class="vitem">
            <span class="vlabel">Game live</span>
            <b>{liveGame || "unknown"}</b>
          </div>
          <p class="vnote">
            {ahead.length
              ? `Documenting ${ahead.length} behaviour${ahead.length === 1 ? "" : "s"} the live build has not caught up with yet. Expected — these describe the designed behaviour, so they are correct, not stale. The list clears as the game ships them.`
              : "The live build matches everything documented here."}
          </p>
        </div>
        {defects.length > 0 && (
          <ul class="defects">
            {defects.map((d) => (
              <li>
                <span class="where">Game bug · {d.surface}</span>
                {d.item}
                {d.bead && <span class="landed">bead {d.bead}</span>}
                <p class="dnote">{d.note}</p>
              </li>
            ))}
          </ul>
        )}
        {ahead.length > 0 && (
          <ul class="ahead">
            {ahead.map((a) => (
              <li>
                <span class="where">{a.where}</span>
                {a.item}
                <span class="landed">{a.state ?? "not yet live"}{a.seenOn ? ` · ${a.seenOn}` : ""}</span>
              </li>
            ))}
          </ul>
        )}
        <div class="tally">
          <span>{MANUAL_CARDS.length} text cards</span>
          <span>·</span>
          <span>{rowCount} lines</span>
          <span>·</span>
          <span>1 living-sprite card ({spriteEntries.length} possible characters)</span>
        </div>
      </header>

      <details class="vhist">
        <summary>Version history — what the game was at each content version</summary>
        <table>
          <thead><tr><th>Content</th><th>Version</th><th>Game at the time</th><th>Date</th><th>What changed</th></tr></thead>
          <tbody>
            {[["Booklet", manual], ["Cards", cards]].flatMap(([label, c]) =>
              (c.history ?? []).map((h) => (
                <tr>
                  <td>{label}</td>
                  <td class="mono">{h.version}</td>
                  <td class="mono">{h.game}</td>
                  <td class="mono">{h.date}</td>
                  <td>{h.note}</td>
                </tr>
              )))}
          </tbody>
        </table>
      </details>

      <section class="grid">
        {MANUAL_CARDS.map((card, i) => (
          <article class="card">
            <div class="card-idx">{String(i + 1).padStart(2, "0")}</div>
            <h2>{card.title}</h2>
            {card.rows && (
              <dl class="rows">
                {card.rows.map(([term, desc]) => (
                  <div class="row">
                    <dt>{term}</dt>
                    <dd>{desc}</dd>
                  </div>
                ))}
              </dl>
            )}
            {card.lines && (
              <ul class="lines">
                {card.lines.map((line) => (
                  <li>{line}</li>
                ))}
              </ul>
            )}
            {card.quote && <blockquote>{card.quote}</blockquote>}
          </article>
        ))}

        <article class="card sprite-card">
          <div class="card-idx">★</div>
          <h2>Living-sprite card</h2>
          <p class="sprite-note">
            A random handcrafted sprite turns and swings, captioned with its role and blurb.
            Any of these can appear:
          </p>
          <dl class="rows sprite-rows">
            {spriteEntries.map(([name, lore]) => (
              <div class="row sprite-row">
                <dt>
                  {name}
                  <span class="sprite-role">{lore.role}</span>
                </dt>
                <dd>{lore.blurb || <em class="empty">— no blurb (name + role only)</em>}</dd>
              </div>
            ))}
          </dl>
        </article>
      </section>
    </div>
</ConsoleLayout>

<style>
  .vbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    align-items: baseline;
    margin: 0.9rem 0 0.2rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--rule, rgba(167, 243, 208, 0.25));
    border-left-width: 3px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.02);
  }
  .vbar-ok { border-left-color: #4ade80; }
  .vbar-ahead { border-left-color: #60a5fa; }
  .vitem { display: flex; align-items: baseline; gap: 0.4rem; }
  .vlabel {
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.65;
  }
  .vitem b { font-size: 1.05rem; font-variant-numeric: tabular-nums; }
  .vsub { font-size: 0.72rem; opacity: 0.6; }
  .vnote { flex-basis: 100%; margin: 0.15rem 0 0; font-size: 0.8rem; opacity: 0.75; }
  .ahead { list-style: none; margin: 0 0 0.9rem; padding: 0; font-size: 0.86rem; }
  .ahead li {
    padding: 0.35rem 0.6rem;
    border-left: 2px solid #60a5fa;
    margin-bottom: 0.3rem;
    background: rgba(96, 165, 250, 0.06);
  }
  .ahead .where,
  .ahead .landed {
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.65;
    margin-right: 0.5rem;
  }
  .ahead .landed { margin: 0 0 0 0.5rem; }
  .defects { list-style: none; margin: 0 0 0.9rem; padding: 0; font-size: 0.86rem; }
  .defects li {
    padding: 0.4rem 0.6rem;
    border-left: 2px solid #f472b6;
    margin-bottom: 0.3rem;
    background: rgba(244, 114, 182, 0.07);
  }
  .defects .dnote { margin: 0.2rem 0 0; font-size: 0.78rem; opacity: 0.7; }
  .vhist { margin: 0.6rem 0 1.4rem; font-size: 0.85rem; }
  .vhist summary { cursor: pointer; opacity: 0.75; }
  .vhist table { width: 100%; border-collapse: collapse; margin-top: 0.7rem; }
  .vhist th {
    text-align: left;
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.6;
    font-weight: 400;
    padding: 0.35rem 0.5rem;
    border-bottom: 1px solid var(--rule, rgba(167, 243, 208, 0.2));
  }
  .vhist td {
    padding: 0.4rem 0.5rem;
    border-bottom: 1px solid var(--rule, rgba(167, 243, 208, 0.12));
    vertical-align: top;
  }
  .vhist .mono { font-variant-numeric: tabular-nums; white-space: nowrap; }
</style>

<style>
  .cards-shell {
    background: var(--panel);
    min-height: calc(100vh - 160px);
  }
  .cards-wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
    color: #d1d5db;
    font-family: "Courier New", monospace;
  }
  .cards-head h1 {
    color: #a7f3d0;
    font-size: 1.35rem;
    margin: 0 0 0.5rem;
    letter-spacing: 0.02em;
  }
  .cards-head p {
    color: #9ca3af;
    font-size: 0.9rem;
    line-height: 1.55;
    max-width: 70ch;
    margin: 0 0 0.75rem;
  }
  .cards-head code {
    color: #a7f3d0;
    background: rgba(167, 243, 208, 0.08);
    padding: 0.05rem 0.3rem;
    border-radius: 3px;
    font-size: 0.85em;
  }
  .tally {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: #6b7280;
    font-size: 0.8rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .card {
    position: relative;
    background: #0e1420;
    border: 1px solid rgba(167, 243, 208, 0.14);
    border-radius: 8px;
    padding: 1rem 1.1rem 1.1rem;
  }
  .card-idx {
    position: absolute;
    top: 0.7rem;
    right: 0.9rem;
    color: rgba(167, 243, 208, 0.35);
    font-size: 0.8rem;
    font-weight: 700;
  }
  .card h2 {
    color: #e0e7ff;
    font-size: 1rem;
    margin: 0 0 0.75rem;
    padding-right: 2rem;
    letter-spacing: 0.01em;
  }

  .rows {
    margin: 0;
    display: grid;
    gap: 0.4rem;
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.3fr);
    gap: 0.75rem;
    align-items: baseline;
  }
  .row dt {
    color: #a7f3d0;
    font-weight: 700;
    font-size: 0.85rem;
    margin: 0;
  }
  .row dd {
    color: #c3cad6;
    font-size: 0.85rem;
    margin: 0;
    line-height: 1.4;
  }

  .lines {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.5rem;
  }
  .lines li {
    color: #c3cad6;
    font-size: 0.86rem;
    line-height: 1.5;
  }
  blockquote {
    margin: 0.75rem 0 0;
    padding-left: 0.75rem;
    border-left: 2px solid rgba(167, 243, 208, 0.3);
    color: #9ca3af;
    font-style: italic;
    font-size: 0.85rem;
  }

  .sprite-card {
    grid-column: 1 / -1;
    border-color: rgba(251, 191, 36, 0.28);
  }
  .sprite-card .card-idx {
    color: rgba(251, 191, 36, 0.55);
  }
  .sprite-note {
    color: #9ca3af;
    font-size: 0.85rem;
    margin: 0 0 0.85rem;
  }
  .sprite-rows {
    grid-template-columns: 1fr;
  }
  @media (min-width: 700px) {
    .sprite-rows {
      grid-template-columns: 1fr 1fr;
      gap: 0.4rem 1.5rem;
    }
  }
  .sprite-row dt {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .sprite-role {
    color: #6b7280;
    font-weight: 400;
    font-size: 0.75rem;
  }
  .empty {
    color: #6b7280;
    font-style: italic;
  }
</style>
