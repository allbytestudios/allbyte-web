---
import ConsoleLayout from "../../../layouts/ConsoleLayout.astro";
import OwnerQuestionsApp from "../../../components/OwnerQuestionsApp.svelte";
---

<ConsoleLayout
  title="Questions — Dev Console — AllByte Studios"
  description="Unified queue of decisions, verifications, and open questions from Arc's agent team."

  active="decisions"
>
  <main class="decisions-shell">
    <OwnerQuestionsApp client:only="svelte" />
</ConsoleLayout>

<style>
  .decisions-shell {
    background: var(--panel);
    min-height: calc(100vh - 160px);
  }
</style>
