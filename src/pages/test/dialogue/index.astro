---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import Footer from "../../../components/Footer.astro";
import DialogueReviewApp from "../../../components/DialogueReviewApp.svelte";
import TestNav from "../../../components/TestNav.svelte";
---

<BaseLayout
  title="Dialogue — Dev Console — AllByte Studios"
  description="Review and tweak in-game dialogue: foldable Zone → NPC → dialogue, edit the lines, save to the overlay Arc applies."
>
  <PageHeader
    theme="engine"
    title="Dev Console"
    backHref="/"
    backLabel="Home"
    breadcrumbs={[{ href: "/", label: "Home" }]}
  />
  <main class="dialogue-shell">
    <TestNav active="dialogue" client:load />
    <DialogueReviewApp client:only="svelte" />
  </main>
  <Footer theme="engine" />
</BaseLayout>

<style>
  .dialogue-shell {
    background: #0a0e17;
    min-height: calc(100vh - 160px);
  }
</style>
