---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import Footer from "../../../components/Footer.astro";
import MarketingQueueApp from "../../../components/MarketingQueueApp.svelte";
import TestNav from "../../../components/TestNav.svelte";
---

<BaseLayout
  title="Marketing Queue — Dev Console — AllByte Studios"
  description="Approve autoplay-capture clips and AI-drafted captions before they ship to social channels."
>
  <PageHeader
    theme="engine"
    title="Dev Console"
    backHref="/"
    backLabel="Home"
    breadcrumbs={[{ href: "/", label: "Home" }]}
  />
  <main class="marketing-shell">
    <TestNav active="marketing" client:load />
    <MarketingQueueApp client:only="svelte" />
  </main>
  <Footer theme="engine" />
</BaseLayout>

<style>
  .marketing-shell {
    background: #0a0e17;
    min-height: calc(100vh - 160px);
  }
</style>
