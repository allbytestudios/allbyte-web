---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import Footer from "../../../components/Footer.astro";
import PlayFunnelApp from "../../../components/PlayFunnelApp.svelte";
import TestNav from "../../../components/TestNav.svelte";
---

<BaseLayout
  title="Play funnel — Dev Console — AllByte Studios"
  description="Anonymous, aggregate play-depth funnel: how far browser players get, and where they drop off."
>
  <PageHeader
    theme="engine"
    title="Dev Console"
    backHref="/"
    backLabel="Home"
    breadcrumbs={[{ href: "/", label: "Home" }]}
  />
  <main class="funnel-shell">
    <TestNav active="players" client:load />
    <PlayFunnelApp client:only="svelte" />
  </main>
  <Footer theme="engine" />
</BaseLayout>

<style>
  .funnel-shell {
    background: #0a0e17;
    min-height: calc(100vh - 160px);
  }
</style>
