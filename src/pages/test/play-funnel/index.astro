---
import ConsoleLayout from "../../../layouts/ConsoleLayout.astro";
import PlayFunnelApp from "../../../components/PlayFunnelApp.svelte";
---

<ConsoleLayout
  title="Play funnel — Dev Console — AllByte Studios"
  description="Anonymous, aggregate play-depth funnel: how far browser players get, and where they drop off."

  active="players"
>
  <main class="funnel-shell">
    <PlayFunnelApp client:only="svelte" />
</ConsoleLayout>

<style>
  .funnel-shell {
    background: var(--panel);
    min-height: calc(100vh - 160px);
  }
</style>
