---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import Footer from "../../../components/Footer.astro";
import TrafficApp from "../../../components/TrafficApp.svelte";
import TestNav from "../../../components/TestNav.svelte";
---

<BaseLayout
  title="Site traffic — Dev Console — AllByte Studios"
  description="Real-user page views and navigation flow, aggregated from the CDN access logs (admin only)."
>
  <PageHeader
    theme="engine"
    title="Dev Console"
    backHref="/"
    backLabel="Home"
    breadcrumbs={[{ href: "/", label: "Home" }]}
  />
  <main class="traffic-shell">
    <TestNav active="traffic" client:load />
    <TrafficApp client:only="svelte" />
  </main>
  <Footer theme="engine" />
</BaseLayout>

<style>
  .traffic-shell {
    background: #0a0e17;
    min-height: calc(100vh - 160px);
  }
</style>
