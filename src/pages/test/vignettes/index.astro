---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import Footer from "../../../components/Footer.astro";
import VignetteReviewApp from "../../../components/VignetteReviewApp.svelte";
import TestNav from "../../../components/TestNav.svelte";
---

<BaseLayout
  title="Relic Vignettes — Dev Console — AllByte Studios"
  description="Review the relic vignette prose tier by tier — the owner-approval gate before the real vignettes land in-game."
>
  <PageHeader
    theme="engine"
    title="Dev Console"
    backHref="/"
    backLabel="Home"
    breadcrumbs={[{ href: "/", label: "Home" }]}
  />
  <main class="vignettes-shell">
    <TestNav active="vignettes" client:load />
    <VignetteReviewApp client:only="svelte" />
  </main>
  <Footer theme="engine" />
</BaseLayout>

<style>
  .vignettes-shell {
    background: #0a0e17;
    min-height: calc(100vh - 160px);
  }
</style>
