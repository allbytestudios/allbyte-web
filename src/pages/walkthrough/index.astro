---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import Footer from "../../components/Footer.astro";
import WalkthroughChrome from "../../components/WalkthroughChrome.svelte";
import WalkthroughChecklist from "../../components/WalkthroughChecklist.svelte";
import WalkthroughShot from "../../components/WalkthroughShot.svelte";
import { getCollection, render } from "astro:content";

// Guided-playthrough structure (2026-07-21): scenes group into three sections
// by `kind`, ordered by `order` within each. The prose is server-rendered here
// so the guide is fully readable without JS — the islands only add navigation,
// ticks, and the lightbox on top.
const SECTIONS = [
  { key: "story", label: "Story Walkthrough" },
  { key: "optional", label: "Other Scenes" },
  { key: "dungeon", label: "The Waterways" },
] as const;

const entries = (await getCollection("walkthrough")).sort(
  (a, b) => a.data.order - b.data.order
);

// Revisit cross-links are DERIVED from the scene FK, not authored. A scene
// visited at several story points appears as several files sharing one `scene`;
// linking them by hand would be one more thing to keep in sync.
const visitsByScene = new Map<string, string[]>();
for (const e of entries) {
  const list = visitsByScene.get(e.data.scene) ?? [];
  list.push(e.data.code);
  visitsByScene.set(e.data.scene, list);
}

const rendered = await Promise.all(
  entries.map(async (entry) => ({
    data: entry.data,
    Content: (await render(entry)).Content,
    alsoAt: (visitsByScene.get(entry.data.scene) ?? []).filter((c) => c !== entry.data.code),
  }))
);

const sections = SECTIONS.map((s) => ({
  ...s,
  scenes: rendered.filter((r) => r.data.kind === s.key),
})).filter((s) => s.scenes.length > 0);

// Compact metadata for the nav island — no prose, no bodies.
const navSections = sections.map((s) => ({
  key: s.key,
  label: s.label,
  scenes: s.scenes.map((r) => ({
    code: r.data.code,
    title: r.data.title,
    kind: r.data.kind ?? "",
    order: r.data.order,
    items: (r.data.items ?? []).map((i) => ({ name: i.name })),
    boss: !!r.data.boss,
  })),
}));

const totalItems = entries.reduce((n, e) => n + (e.data.items?.length ?? 0), 0);
---

<BaseLayout
  title="Walkthrough: Laria — The Chronicles of Nesis — AllByte Studios"
  description="A complete guided playthrough of Laria Village in The Chronicles of Nesis — scene-by-scene directions, annotated screenshots, every findable item, and the Mother Slime boss fight."
>
  <PageHeader
    theme="heart"
    title="Walkthrough"
    backHref="/"
    backLabel="Home"
    breadcrumbs={[{ href: "/", label: "Home" }]}
  />

  <main class="wt-page">
    <div class="wt-intro">
      <h1>Laria Village</h1>
      <p class="lede">
        A complete guided playthrough of the opening area — the critical path in play order,
        the optional rooms worth a detour, and the Waterways dungeon down to the Mother Slime.
      </p>
      <p class="meta">
        {entries.length} scenes · {totalItems} findable items · tick them off as you go
      </p>
    </div>

    <div class="wt-layout">
      <WalkthroughChrome sections={navSections} client:load />

      <article class="wt-doc">
        {
          sections.map((section) => (
            <section class="wt-section">
              <h2 class="section-head" id={`section-${section.key}`}>
                {section.label}
              </h2>
              {section.scenes.map((s) => {
                // Astro renders a component only from a capitalized standalone
                // binding — `<s.Content />` as a member expression silently
                // emits nothing, leaving an empty prose div and no build error.
                const SceneProse = s.Content;
                return (
                <section class="wt-scene" id={s.data.code} data-code={s.data.code}>
                  <header class="scene-head">
                    <span class="scene-code">{s.data.code}</span>
                    <h3>{s.data.title}</h3>
                    {s.data.kind && <span class="scene-kind">{s.data.kind}</span>}
                  </header>

                  {s.alsoAt.length > 0 && (
                    <p class="revisit">
                      Also visited at{" "}
                      {s.alsoAt.map((c, i) => (
                        <>
                          {i > 0 && ", "}
                          <a href={`#${c}`}>{c}</a>
                        </>
                      ))}
                    </p>
                  )}

                  {s.data.screenshots?.map((shot, shotIdx) => (
                    <WalkthroughShot
                      name={shot.replace(/\.[^.]+$/, "")}
                      alt={`${s.data.title} — ${s.data.code}`}
                      indicators={s.data.indicators ?? []}
                      eager={s.data.order === 1 && shotIdx === 0}
                      client:visible
                    />
                  ))}

                  {/* client:load, not client:visible — the first checklist is
                      above the fold, and a tick that lands before hydration is
                      silently lost. These are tiny components; the eager cost is
                      cheaper than a dropped interaction. */}
                  <WalkthroughChecklist
                    code={s.data.code}
                    items={s.data.items ?? []}
                    client:load
                  />

                  <div class="wt-prose">
                    <SceneProse />
                  </div>

                  {s.data.boss && (
                    <aside class="boss-card">
                      <h4>Boss — {s.data.boss.name}</h4>
                      <dl>
                        {s.data.boss.hp != null && (
                          <div><dt>HP</dt><dd>{s.data.boss.hp}</dd></div>
                        )}
                        {s.data.boss.cond != null && (
                          <div><dt>Story flag</dt><dd>cond {s.data.boss.cond}</dd></div>
                        )}
                        {s.data.boss.steal?.length > 0 && (
                          <div><dt>Steal</dt><dd>{s.data.boss.steal.join(", ")}</dd></div>
                        )}
                        {s.data.boss.attacks?.length > 0 && (
                          <div><dt>Attacks</dt><dd>{s.data.boss.attacks.join(", ")}</dd></div>
                        )}
                      </dl>
                      {s.data.boss.notes && <p class="boss-notes">{s.data.boss.notes}</p>}
                    </aside>
                  )}
                </section>
                );
              })}
            </section>
          ))
        }
      </article>
    </div>
  </main>

  <Footer theme="heart" />
</BaseLayout>

<style>
  .wt-page {
    background: var(--heart-bg, #cec08a);
    min-height: calc(100vh - 160px);
    color: var(--heart-text, #2a2218);
    font-family: Georgia, "Times New Roman", serif;
  }
  .wt-intro {
    max-width: 1180px; margin: 0 auto; padding: 2rem 1.5rem 1rem;
  }
  .wt-intro h1 {
    margin: 0 0 0.4rem; font-size: clamp(1.8rem, 4vw, 2.6rem);
    color: var(--heart-accent, #3a3020); letter-spacing: 0.01em;
  }
  .lede { margin: 0 0 0.5rem; font-size: 1rem; line-height: 1.6; max-width: 62ch; }
  .meta { margin: 0; font-size: 0.8rem; color: var(--heart-accent-dim, #5a4d38); }

  .wt-layout {
    max-width: 1180px; margin: 0 auto; padding: 1rem 1.5rem 3rem;
    display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: 2.2rem; align-items: start;
  }

  .wt-section { margin-bottom: 2.5rem; }
  .section-head {
    font-size: 1.35rem; color: var(--heart-accent, #3a3020); margin: 0 0 1.2rem;
    padding-bottom: 0.4rem; border-bottom: 2px solid var(--heart-card-border, #7a6e52);
    letter-spacing: 0.02em;
  }

  .wt-scene {
    background: rgba(253, 246, 227, 0.42);
    border: 1.5px solid rgba(122, 110, 82, 0.5); border-radius: 6px;
    padding: 1.1rem 1.3rem 1.3rem; margin-bottom: 1.6rem; scroll-margin-top: 1rem;
  }
  .scene-head { display: flex; align-items: baseline; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 0.6rem; }
  .scene-code {
    font-size: 0.72rem; color: var(--heart-accent-dim, #5a4d38); letter-spacing: 0.05em;
    background: rgba(58, 48, 32, 0.1); padding: 0.12rem 0.45rem; border-radius: 3px;
  }
  .scene-head h3 { margin: 0; font-size: 1.15rem; color: var(--heart-accent, #3a3020); flex: 1; min-width: 0; }
  .scene-kind {
    font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--heart-accent-dim, #5a4d38); border: 1px solid rgba(58, 48, 32, 0.3);
    padding: 0.08rem 0.4rem; border-radius: 999px;
  }
  .revisit { margin: 0 0 0.7rem; font-size: 0.78rem; color: var(--heart-accent-dim, #5a4d38); font-style: italic; }
  .revisit a { color: var(--heart-accent, #3a3020); }

  .wt-prose { font-size: 0.95rem; line-height: 1.7; }
  .wt-prose :global(p) { margin: 0 0 0.85rem; }
  .wt-prose :global(strong) { color: var(--heart-accent, #3a3020); }
  .wt-prose :global(a) { color: #2c5580; }
  .wt-prose :global(table) { width: 100%; border-collapse: collapse; margin: 0.9rem 0; font-size: 0.85rem; }
  .wt-prose :global(th), .wt-prose :global(td) {
    border: 1px solid rgba(122, 110, 82, 0.55); padding: 0.35rem 0.55rem; text-align: left;
  }
  .wt-prose :global(th) { background: rgba(58, 48, 32, 0.1); }
  .wt-prose :global(blockquote) {
    margin: 0.9rem 0; padding: 0.5rem 0.9rem; border-left: 3px solid var(--heart-card-border, #7a6e52);
    background: rgba(58, 48, 32, 0.06); font-size: 0.9rem;
  }
  .wt-prose :global(hr) { border: 0; border-top: 1px solid rgba(122, 110, 82, 0.5); margin: 1.2rem 0; }

  /* Inline ::shot figures — plain HTML from the remark transform, so they're
     styled here rather than in a component. */
  .wt-prose :global(.wt-inline-shot) { margin: 1.2rem 0; }
  .wt-prose :global(.inline-shot-btn) {
    display: block; width: 100%; padding: 0; cursor: zoom-in; line-height: 0; background: none;
    border: 2px solid var(--heart-card-border, #7a6e52); border-radius: 4px; overflow: hidden;
  }
  .wt-prose :global(.inline-shot-btn:focus-visible) {
    outline: 3px solid var(--heart-accent, #3a3020); outline-offset: 2px;
  }
  .wt-prose :global(.inline-shot-btn img) { width: 100%; height: auto; display: block; }
  .wt-prose :global(.inline-shot-cap) {
    margin: 0.4rem 0 0; font-size: 0.82rem; font-style: italic;
    color: var(--heart-accent-dim, #5a4d38); text-align: center;
  }
  @media (max-width: 900px) {
    .wt-prose :global(.inline-shot-btn img) { max-height: 60svh; width: auto; margin: 0 auto; }
  }

  .boss-card {
    margin-top: 1.1rem; border: 2px solid #8f3323; border-radius: 5px;
    background: rgba(143, 51, 35, 0.07); padding: 0.8rem 1rem;
  }
  .boss-card h4 {
    margin: 0 0 0.55rem; font-size: 0.95rem; color: #8f3323;
    text-transform: uppercase; letter-spacing: 0.05em;
  }
  .boss-card dl { margin: 0; display: flex; flex-wrap: wrap; gap: 0.4rem 1.6rem; }
  .boss-card dl div { display: flex; gap: 0.4rem; align-items: baseline; }
  .boss-card dt {
    font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.05em;
    color: var(--heart-accent-dim, #5a4d38);
  }
  .boss-card dd { margin: 0; font-size: 0.88rem; font-weight: 600; }
  .boss-notes { margin: 0.6rem 0 0; font-size: 0.84rem; line-height: 1.55; }

  @media (max-width: 900px) {
    .wt-layout { grid-template-columns: 1fr; gap: 0; padding: 0 1rem 2.5rem; }
    .wt-intro { padding: 1.4rem 1rem 0.8rem; }
    .wt-scene { padding: 0.9rem 1rem 1.1rem; }
  }
</style>
