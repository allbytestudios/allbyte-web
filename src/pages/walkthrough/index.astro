---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import Footer from "../../components/Footer.astro";
import WalkthroughApp from "../../components/WalkthroughApp.svelte";
---

<BaseLayout
  title="Walkthrough — The Chronicles of Nesis — AllByte Studios"
  description="A published-style game walkthrough for The Chronicles of Nesis. Chapter-by-chapter screenshots, maps, dialogue excerpts, and combat strategy. Available to Legend subscribers."
>
  <PageHeader
    theme="heart"
    title="Walkthrough"
    backHref="/"
    backLabel="Home"
    breadcrumbs={[{ href: "/", label: "Home" }]}
  />
  <main class="walkthrough-page">
    <WalkthroughApp client:only="svelte" />
  </main>
  <Footer theme="heart" />
</BaseLayout>

<style>
  .walkthrough-page {
    background: #f4ebd0;
    min-height: calc(100vh - 160px);
  }
</style>
