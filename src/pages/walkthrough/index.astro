---
import ManualLayout from "../../layouts/ManualLayout.astro";
import WalkthroughChrome from "../../components/WalkthroughChrome.svelte";
import WalkthroughChecklist from "../../components/WalkthroughChecklist.svelte";
import WalkthroughShot from "../../components/WalkthroughShot.svelte";
import WalkthroughEditor from "../../components/WalkthroughEditor.svelte";
import { getCollection, render } from "astro:content";
import spine from "../../data/story-spine.json";

// Narrative-spine render (2026-07-23): the guide is a 4-level outline —
// chapter → section → step → scene — driven entirely by src/data/story-spine.json
// (Quinn owns its contents). The STEP label is the only heading; a scene's
// `title` is just a muted location label, and `kind: transit` scenes render as a
// one-line route between stops. Ordering + membership come from the spine + the
// per-scene `step` tag, so Quinn's content churn lands as data, never code.
type Rendered = {
  data: any;
  Content: Awaited<ReturnType<typeof render>>["Content"];
  alsoAt: string[];
  body: string;
};

const entries = (await getCollection("walkthrough")).sort(
  (a, b) => a.data.order - b.data.order
);

// Revisit cross-links are DERIVED from the scene FK, not authored. A scene
// visited at several story points shares one `scene` across several files.
const visitsByScene = new Map<string, string[]>();
for (const e of entries) {
  const list = visitsByScene.get(e.data.scene) ?? [];
  list.push(e.data.code);
  visitsByScene.set(e.data.scene, list);
}

const rendered: Rendered[] = await Promise.all(
  entries.map(async (entry) => ({
    data: entry.data,
    Content: (await render(entry)).Content,
    alsoAt: (visitsByScene.get(entry.data.scene) ?? []).filter((c) => c !== entry.data.code),
    body: entry.body ?? "",
  }))
);

// Bucket scenes by their step tag (already globally order-sorted).
const byStep = new Map<string, Rendered[]>();
for (const r of rendered) {
  const list = byStep.get(r.data.step) ?? [];
  list.push(r);
  byStep.set(r.data.step, list);
}

// Build the outline from the spine, dropping any chapter/section/step with no
// scenes (e.g. the Laria Valley placeholder, or leaving-laria if it were empty).
const chapters = (spine.chapters ?? [])
  .map((ch: any) => ({
    key: ch.key,
    label: ch.label,
    sections: (ch.sections ?? [])
      .map((sec: any) => ({
        key: sec.key,
        label: sec.label,
        steps: (sec.steps ?? [])
          .map((st: any) => ({ key: st.key, label: st.label, scenes: byStep.get(st.key) ?? [] }))
          .filter((st: any) => st.scenes.length > 0),
      }))
      .filter((sec: any) => sec.steps.length > 0),
  }))
  .filter((ch: any) => ch.sections.length > 0);

const chapterLabel = chapters[0]?.label ?? "Walkthrough";
const stepCount = chapters.reduce(
  (n: number, ch: any) => n + ch.sections.reduce((m: number, s: any) => m + s.steps.length, 0),
  0
);
const totalItems = entries.reduce((n, e) => n + (e.data.items?.length ?? 0), 0);

// Raw scene bodies for the inline editor (admin) — BODY markdown only; the editor
// never touches frontmatter. Escaping `<` keeps the JSON from closing the tag.
const sceneBodies: Record<string, { body: string; scene?: string }> = {};
for (const r of rendered) sceneBodies[r.data.code] = { body: r.body, scene: r.data.scene };
const bodiesJson = JSON.stringify(sceneBodies).replace(/</g, "\\u003c");

// Compact nav model — sections → steps (the outline the reader scans + spies on).
const navSections = chapters.flatMap((ch: any) =>
  ch.sections.map((section: any) => ({
    key: section.key,
    label: section.label,
    steps: section.steps.map((step: any) => ({
      key: step.key,
      label: step.label,
      boss: step.scenes.some((s: any) => !!s.data.boss),
      items: step.scenes.flatMap((s: any) =>
        (s.data.items ?? []).map((i: any) => ({ code: s.data.code, name: i.name }))
      ),
    })),
  }))
);
---

<ManualLayout
  title="Walkthrough: Laria — The Chronicles of Nesis — AllByte Studios"
  description="A complete guided playthrough of Laria Village in The Chronicles of Nesis — step-by-step directions, annotated screenshots, every findable item, and the Mother Slime boss fight."
  active="/walkthrough/"
>
  <main class="wt-page">
    <div class="wt-intro">
      <h1>{chapterLabel}</h1>
      <p class="lede">
        A complete guided playthrough of the opening area — every story step in play order,
        the optional rooms worth a detour, and the Waterways dungeon down to the Mother Slime.
      </p>
      <p class="meta">
        {stepCount} steps · {entries.length} scenes · {totalItems} findable items · tick them off as you go
      </p>
    </div>

    <div class="wt-layout">
      <WalkthroughChrome sections={navSections} client:load />

      <article class="wt-doc">
        {
          chapters.map((chapter, ci) => (
            <>
              {ci > 0 && <h2 class="chapter-head">{chapter.label}</h2>}
              {chapter.sections.map((section) => (
                <section class="wt-section">
                  <h2 class="section-head" id={`section-${section.key}`}>
                    {section.label}
                  </h2>
                  {section.steps.map((step) => (
                    <section class="wt-step" id={step.key} data-step={step.key}>
                      <h3 class="step-head">{step.label}</h3>
                      {step.scenes.map((s) => {
                        // Astro renders a component only from a capitalized
                        // standalone binding — a member expression emits nothing.
                        const SceneProse = s.Content;
                        if (s.data.kind === "transit") {
                          // Connective scene: a single muted route line, no chrome.
                          return (
                            <div class="wt-transit" id={s.data.code} data-code={s.data.code}>
                              <span class="transit-loc">{s.data.title}</span>
                              <div class="transit-route">
                                <SceneProse />
                              </div>
                            </div>
                          );
                        }
                        return (
                          <section class="wt-scene" id={s.data.code} data-code={s.data.code}>
                            <header class="scene-head">
                              <span class="scene-loc">{s.data.title}</span>
                              {s.data.kind && s.data.kind !== "story" && (
                                <span class="scene-kind">{s.data.kind}</span>
                              )}
                            </header>

                            {s.alsoAt.length > 0 && (
                              <p class="revisit">
                                Also visited at{" "}
                                {s.alsoAt.map((c, i) => (
                                  <>
                                    {i > 0 && ", "}
                                    <a href={`#${c}`}>{c}</a>
                                  </>
                                ))}
                              </p>
                            )}

                            {s.data.screenshots?.map((shot, shotIdx) => (
                              <WalkthroughShot
                                name={shot.replace(/\.[^.]+$/, "")}
                                alt={`${s.data.title} — ${s.data.code}`}
                                indicators={s.data.indicators ?? []}
                                eager={s.data.order === 1 && shotIdx === 0}
                                client:visible
                              />
                            ))}

                            {/* client:load, not client:visible — the first
                                checklist is above the fold, and a tick that
                                lands before hydration is silently lost. */}
                            <WalkthroughChecklist
                              code={s.data.code}
                              items={s.data.items ?? []}
                              client:load
                            />

                            <div class="wt-prose">
                              <SceneProse />
                            </div>

                            {s.data.boss && (
                              <aside class="boss-card">
                                <h4>Boss — {s.data.boss.name}</h4>
                                <dl>
                                  {s.data.boss.hp != null && (
                                    <div><dt>HP</dt><dd>{s.data.boss.hp}</dd></div>
                                  )}
                                  {s.data.boss.cond != null && (
                                    <div><dt>Story flag</dt><dd>cond {s.data.boss.cond}</dd></div>
                                  )}
                                  {s.data.boss.steal?.length > 0 && (
                                    <div><dt>Steal</dt><dd>{s.data.boss.steal.join(", ")}</dd></div>
                                  )}
                                  {s.data.boss.attacks?.length > 0 && (
                                    <div><dt>Attacks</dt><dd>{s.data.boss.attacks.join(", ")}</dd></div>
                                  )}
                                </dl>
                                {s.data.boss.notes && <p class="boss-notes">{s.data.boss.notes}</p>}
                              </aside>
                            )}
                          </section>
                        );
                      })}
                    </section>
                  ))}
                </section>
              ))}
            </>
          ))
        }
      </article>
    </div>

    <script type="application/json" id="wt-scene-bodies" is:inline set:html={bodiesJson}></script>
    <WalkthroughEditor client:load />
  </main>

</ManualLayout>

<style>
  .wt-page {
    /* parchment comes from <body> (manual.css) */
    min-height: calc(100vh - 160px);
    color: var(--ink);
    /* Body prose takes the reading serif; the h2/h3 heads keep AllByteCustom
       via manual.css. The page previously set the display face on everything,
       which is heavy over a walkthrough's worth of running text. */
    font-family: "Iowan Old Style", "Palatino Linotype", "Book Antiqua", Georgia, serif;
  }
  .wt-intro {
    max-width: 1180px; margin: 0 auto; padding: 2rem 1.5rem 1rem;
  }
  .wt-intro h1 {
    margin: 0 0 0.4rem; font-size: clamp(1.8rem, 4vw, 2.6rem);
    color: var(--crimson); letter-spacing: 0.01em;
  }
  .lede { margin: 0 0 0.5rem; font-size: 1rem; line-height: 1.6; max-width: 62ch; }
  .meta { margin: 0; font-size: 0.8rem; color: var(--ink-soft); }

  .wt-layout {
    max-width: 1180px; margin: 0 auto; padding: 1rem 1.5rem 3rem;
    display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: 2.2rem; align-items: start;
  }

  .chapter-head {
    font-size: clamp(1.6rem, 3.5vw, 2.2rem); color: var(--crimson);
    margin: 2.5rem 0 1.2rem; letter-spacing: 0.01em;
  }
  .wt-section { margin-bottom: 2.5rem; }
  /* Section — the mid-level band (Exploring Laria / Into the Waterways / …). */
  .section-head {
    font-size: 1.35rem; color: var(--crimson); margin: 0 0 1.2rem;
    padding-bottom: 0.4rem; border-bottom: 2px solid var(--rule);
    letter-spacing: 0.02em; scroll-margin-top: 1rem;
  }
  /* Step — the ONLY real heading a reader navigates by ("Waking Up", …). */
  .wt-step { margin-bottom: 1.8rem; scroll-margin-top: 1rem; }
  .step-head {
    font-size: 1.08rem; color: var(--crimson); margin: 0 0 0.8rem;
    letter-spacing: 0.01em; display: flex; align-items: baseline; gap: 0.5rem;
  }
  .step-head::before {
    content: ""; flex: none; width: 0.5rem; height: 0.5rem; border-radius: 50%;
    background: var(--rule); transform: translateY(-0.15em);
  }

  .wt-scene {
    background: var(--panel);
    border: 1.5px solid var(--rule); border-radius: 6px;
    padding: 1.1rem 1.3rem 1.3rem; margin-bottom: 1.1rem; scroll-margin-top: 1rem;
  }
  .scene-head { display: flex; align-items: baseline; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 0.6rem; }
  /* Location label — de-emphasized "you are here", NOT a heading. */
  .scene-loc {
    font-size: 0.82rem; color: var(--ink-soft); font-style: italic;
    letter-spacing: 0.01em;
  }
  .scene-kind {
    font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--ink-soft); border: 1px solid var(--rule);
    padding: 0.08rem 0.4rem; border-radius: 999px;
  }
  .revisit { margin: 0 0 0.7rem; font-size: 0.78rem; color: var(--ink-soft); font-style: italic; }
  .revisit a { color: var(--crimson); }

  /* Transit — connective tissue between stops. One muted route line, no card. */
  .wt-transit {
    display: flex; align-items: baseline; gap: 0.6rem; flex-wrap: wrap;
    padding: 0.15rem 0.2rem 0.15rem 0.9rem; margin: 0 0 1.1rem;
    border-left: 2px dashed rgba(122, 110, 82, 0.55);
  }
  .transit-loc {
    font-size: 0.76rem; color: var(--ink-soft); font-style: italic; flex: none;
  }
  .transit-route { font-size: 0.9rem; line-height: 1.5; }
  .transit-route :global(p) { margin: 0.1rem 0; }
  .transit-route :global(strong) { color: var(--crimson); }

  .wt-prose { font-size: 0.95rem; line-height: 1.7; }
  .wt-prose :global(p) { margin: 0 0 0.85rem; }
  .wt-prose :global(strong) { color: var(--crimson); }
  .wt-prose :global(a) { color: var(--crimson); text-underline-offset: 2px; }
  .wt-prose :global(table) { width: 100%; border-collapse: collapse; margin: 0.9rem 0; font-size: 0.85rem; }
  .wt-prose :global(th), .wt-prose :global(td) {
    border: 1px solid rgba(122, 110, 82, 0.55); padding: 0.35rem 0.55rem; text-align: left;
  }
  .wt-prose :global(th) { background: rgba(58, 48, 32, 0.1); }
  .wt-prose :global(blockquote) {
    margin: 0.9rem 0; padding: 0.5rem 0.9rem; border-left: 3px solid var(--rule);
    background: rgba(58, 48, 32, 0.06); font-size: 0.9rem;
  }
  .wt-prose :global(hr) { border: 0; border-top: 1px solid var(--rule); margin: 1.2rem 0; }

  /* Pro Tip — skippable advice; the subtle default blockquote is fine. */
  .wt-prose :global(blockquote.wt-tip) {
    border-left-color: var(--gilt); background: var(--paperblend);
  }
  /* TO PROGRESS — an unintuitive story gate ("you are stuck, this is why").
     Deliberately LOUDER than a tip: a saturated amber signpost with a filled
     left bar, so it can't be scrolled past. */
  .wt-prose :global(blockquote.wt-progress) {
    border-left: 5px solid var(--crimson); background: var(--panel);
    padding: 0.65rem 1rem; border-radius: 0 4px 4px 0; margin: 1.1rem 0;
  }
  .wt-prose :global(blockquote.wt-progress) :global(strong:first-child) {
    color: var(--crimson); text-transform: uppercase; letter-spacing: 0.04em; font-size: 0.9em;
  }

  /* Inline ::shot figures — plain HTML from the remark transform. */
  .wt-prose :global(.wt-inline-shot) { margin: 1.2rem 0; }
  .wt-prose :global(.inline-shot-btn) {
    display: block; width: 100%; padding: 0; cursor: zoom-in; line-height: 0; background: none;
    border: 2px solid var(--rule); border-radius: 4px; overflow: hidden;
  }
  .wt-prose :global(.inline-shot-btn:focus-visible) {
    outline: 3px solid var(--crimson); outline-offset: 2px;
  }
  .wt-prose :global(.inline-shot-btn img) { width: 100%; height: auto; display: block; }
  .wt-prose :global(.inline-shot-cap) {
    margin: 0.4rem 0 0; font-size: 0.82rem; font-style: italic;
    color: var(--ink-soft); text-align: center;
  }
  @media (max-width: 900px) {
    .wt-prose :global(.inline-shot-btn img) { max-height: 60svh; width: auto; margin: 0 auto; }
  }

  .boss-card {
    margin-top: 1.1rem; border: 2px solid var(--crimson); border-radius: 5px;
    background: rgba(143, 51, 35, 0.07); padding: 0.8rem 1rem;
  }
  .boss-card h4 {
    margin: 0 0 0.55rem; font-size: 0.95rem; color: var(--crimson);
    text-transform: uppercase; letter-spacing: 0.05em;
  }
  .boss-card dl { margin: 0; display: flex; flex-wrap: wrap; gap: 0.4rem 1.6rem; }
  .boss-card dl div { display: flex; gap: 0.4rem; align-items: baseline; }
  .boss-card dt {
    font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.05em;
    color: var(--ink-soft);
  }
  .boss-card dd { margin: 0; font-size: 0.88rem; font-weight: 600; }
  .boss-notes { margin: 0.6rem 0 0; font-size: 0.84rem; line-height: 1.55; }

  @media (max-width: 900px) {
    .wt-layout { grid-template-columns: 1fr; gap: 0; padding: 0 1rem 2.5rem; }
    .wt-intro { padding: 1.4rem 1rem 0.8rem; }
    .wt-scene { padding: 0.9rem 1rem 1.1rem; }
  }
</style>
